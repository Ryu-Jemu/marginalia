---
interface Props { kind: 'pricing' | 'beam'; compact?: boolean }
const { kind, compact = false } = Astro.props;
const pricing = kind === 'pricing';
const stages = pricing ? [
  { title: '망 상태', detail: '자원 · 사용자 수', icon: '◌' },
  { title: '요금 정책', detail: '강화학습 기반 선택', icon: '↗' },
  { title: '사용자 반응', detail: '서비스 선택 · 유지', icon: '⇄' },
] : [
  { title: '통신 과제', detail: '무선통신 문제 정리', icon: '⌁' },
  { title: 'LLM 활용', detail: '적용 방식 분류', icon: '◇' },
  { title: '연구 쟁점', detail: '적용 조건 · 한계', icon: '↗' },
];
---
<figure class:list={['research-visual', { compact }]}>
  <ol class="research-flow" data-flow aria-label={pricing ? '강화학습 요금 정책의 피드백 흐름' : '무선통신 LLM 서베이의 분류 흐름'}>
    {stages.map((stage,index) => <li data-flow-stage><div class="research-icon" aria-hidden="true">{stage.icon}</div><strong>{stage.title}</strong><span>{stage.detail}</span>{index < stages.length - 1 && <i class="research-connector" aria-hidden="true"><b data-flow-line></b><em>→</em></i>}</li>)}
  </ol>
  <div class="research-feedback"><svg viewBox="0 0 300 30" aria-hidden="true" preserveAspectRatio="none"><path d="M290 0V18Q290 23 283 23H17Q10 23 10 18V3"/><path d="M5 8L10 3L15 8"/></svg><span>{pricing ? '수익과 서비스 유지 → 다음 정책에 반영' : '문헌 비교 → 가능성과 제약의 체계화'}</span></div>
  <figcaption>{pricing ? '즉시 수익과 장기 서비스 유지의 관계를 살피는 정책 비교.' : '무선통신에서 LLM을 활용하는 방법과 남은 과제를 정리한 공동 연구.'}</figcaption>
</figure>
<style>
  .research-visual{background:var(--surface);border-radius:18px;padding:36px 26px 28px;min-width:0}
  .research-flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;list-style:none;padding:0;margin:0}
  .research-flow li{min-width:0;position:relative;text-align:center;margin:0}
  .research-icon{display:grid;place-items:center;width:56px;height:56px;margin:0 auto 18px;border-radius:16px;color:var(--blue);background:var(--paper);border:1px solid var(--line);font-size:26px;line-height:1}
  [data-active] .research-icon{color:#fff;background:var(--blue);border-color:var(--blue)}
  .research-flow strong{display:block;font-size:18px;font-weight:650;line-height:1.4}
  .research-flow li>span{display:block;font-size:14px;line-height:1.5;color:var(--muted);margin-top:7px}
  .research-connector{position:absolute;left:calc(50% + 36px);right:calc(-50% + 12px);top:27px;height:1px;background:var(--line)}
  .research-connector b{position:absolute;inset:0;background:var(--blue);transform-origin:left}
  .research-connector em{font-style:normal;position:absolute;right:-2px;top:-13px;font-size:16px;color:var(--blue)}
  .research-feedback{margin:24px auto 0;max-width:calc(100% - 60px);text-align:center}.research-feedback svg{height:30px;width:100%;stroke:var(--blue);stroke-width:1.3;fill:none}.research-feedback span{font-size:14px;color:var(--blue);display:block;margin-top:12px;line-height:1.5}
  figcaption{font-size:14px;line-height:1.6;color:var(--muted);margin-top:26px}
  .compact{padding-inline:20px}.compact .research-flow{gap:16px}.compact .research-flow strong{font-size:16px}
  @media(max-width:600px){.research-visual{padding:28px 16px 24px}.research-flow{gap:16px}.research-icon{width:46px;height:46px;border-radius:12px;font-size:23px;margin-bottom:14px}.research-flow strong{font-size:16px}.research-connector{top:22px;left:calc(50% + 28px);right:calc(-50% + 12px)}.research-feedback{max-width:calc(100% - 40px)}.research-flow li>span{font-size:14px}}
</style>
