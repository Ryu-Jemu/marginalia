---
import { t, type Lang } from '../../i18n/ui';

/**
 * The correlation matrix the study drew before it read the regression.
 *
 * Recomputed from `merged.csv` — the twenty-five rows the model was fitted on —
 * rather than lifted from the study's seaborn output, so the plate and the
 * sentence beside it are the same numbers. Printed to two decimals, which is
 * what the original `value_heatmap.py` printed.
 *
 * Every coefficient here is positive, so a diverging scale would spend half its
 * range on values that do not occur. One ramp from paper to the accent carries
 * it, and the number is printed in every cell regardless — the shade is for
 * scanning, the figure is for reading.
 *
 * The diagonal is drawn hollow. A row's correlation with itself is 1 by
 * construction and carries no information; filling it solid would put the six
 * darkest cells on the plate where there is nothing to see.
 */
interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

/** pandas `.corr()` over the five inputs and the outcome, n = 25. */
const KEYS = ['cctv', 'crime', 'population', 'income', 'venues', 'lights'] as const;
const M: number[][] = [
  [1.0, 0.6088, 0.5393, 0.3395, 0.1775, 0.3427],
  [0.6088, 1.0, 0.6469, 0.4966, 0.5181, 0.6499],
  [0.5393, 0.6469, 1.0, 0.055, 0.0059, 0.3468],
  [0.3395, 0.4966, 0.055, 1.0, 0.1792, 0.7081],
  [0.1775, 0.5181, 0.0059, 0.1792, 1.0, 0.2319],
  [0.3427, 0.6499, 0.3468, 0.7081, 0.2319, 1.0],
];

const LABEL = KEYS.map((k) => t(lang, `viz.heat.${k}`));

const L = 92; // room for the row labels
const CELL_W = 68;
const CELL_H = 38;
const TOP = 30;
const N = KEYS.length;
const W = L + N * CELL_W + 4;
const H = TOP + N * CELL_H + 30;

const x = (c: number) => L + c * CELL_W;
const y = (r: number) => TOP + r * CELL_H;

/** The strongest pair that is not a variable with itself. */
let peak = { r: 0, c: 0, v: 0 };
for (let r = 0; r < N; r++)
  for (let c = 0; c < N; c++)
    if (r !== c && M[r][c] > peak.v) peak = { r, c, v: M[r][c] };
---

<svg
  class="viz heat"
  data-viz="heat"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={t(lang, 'viz.heat.aria')}
>
  {
    LABEL.map((name, c) => (
      <text class="viz-label heat__head" x={x(c) + CELL_W / 2} y={TOP - 10} text-anchor="middle">
        {name}
      </text>
    ))
  }

  {
    M.map((row, r) => (
      <>
        <text class="heat__row" x={L - 10} y={y(r) + CELL_H / 2 + 3.5} text-anchor="end">
          {LABEL[r]}
        </text>
        {row.map((v, c) => (
          <g data-heat-cell style={`--k:${r * N + c}`}>
            <rect
              class:list={['heat__cell', r === c && 'heat__cell--self']}
              x={x(c)}
              y={y(r)}
              width={CELL_W - 2}
              height={CELL_H - 2}
              style={r === c ? undefined : `--v:${(v * 82).toFixed(1)}%`}
            />
            <text
              class:list={[
                'heat__v',
                r === c && 'heat__v--self',
                r !== c && v >= 0.62 && 'heat__v--onfill',
              ]}
              x={x(c) + (CELL_W - 2) / 2}
              y={y(r) + CELL_H / 2 + 3.5}
              text-anchor="middle"
            >
              {v.toFixed(2)}
            </text>
          </g>
        ))}
      </>
    ))
  }

  {/* The pair the collinearity check was run for. Both cells, because the
      matrix is symmetric and marking one of a mirrored pair reads as a slip. */}
  {
    [
      [peak.r, peak.c],
      [peak.c, peak.r],
    ].map(([r, c]) => (
      <rect
        class="heat__peak"
        x={x(c) - 1.5}
        y={y(r) - 1.5}
        width={CELL_W + 1}
        height={CELL_H + 1}
        rx="2"
      />
    ))
  }

  <text class="viz-label heat__foot" x="0" y={H - 8}>
    {t(lang, 'viz.heat.foot', { peak: peak.v.toFixed(2) })}
  </text>
</svg>

<style>
  .heat {
    display: block;
  }
  .heat :global(.heat__cell) {
    fill: color-mix(in srgb, var(--rubric) var(--v, 0%), var(--paper-inset));
    stroke: var(--paper);
    stroke-width: 1;
  }
  /* Hollow: a variable's correlation with itself is 1 by construction. */
  .heat :global(.heat__cell--self) {
    fill: none;
    stroke: var(--rule);
    stroke-dasharray: 2 2;
  }
  .heat :global(.heat__head) {
    font-size: 8.5px;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .heat :global(.heat__row) {
    font-family: var(--family-mono);
    font-size: 9px;
    fill: var(--ink-muted);
  }
  .heat :global(.heat__v) {
    font-family: var(--family-mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    fill: var(--ink);
  }
  .heat :global(.heat__v--onfill) {
    fill: var(--on-rubric);
  }
  .heat :global(.heat__v--self) {
    fill: var(--ink-faint);
  }
  .heat :global(.heat__peak) {
    fill: none;
    stroke: var(--scope);
    stroke-width: 1.4;
  }
  .heat :global(.heat__foot) {
    fill: var(--ink-faint);
  }
</style>
