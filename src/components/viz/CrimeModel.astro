---
/**
 * The regression, and the variable the project expected to matter.
 *
 * Five inputs, one model, R² 0.843. The two significant ones are drawn in the
 * accent; CCTV — the premise the project started from — is struck through. The
 * point of the figure is that the expected answer is the one that failed.
 */
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const VARS = [
  { name: t(lang, 'viz.crime.model.var.venues'), p: 'p = 0.0004', sig: true },
  { name: t(lang, 'viz.crime.model.var.population'), p: 'p = 0.0006', sig: true },
  { name: t(lang, 'viz.crime.model.var.income'), p: '', sig: false },
  { name: t(lang, 'viz.crime.model.var.lights'), p: t(lang, 'viz.crime.model.estimated'), sig: false },
  { name: t(lang, 'viz.crime.model.var.cctv'), p: t(lang, 'viz.crime.model.cctv.p'), sig: false, struck: true },
];

const W = 700;
const ROW = 26;
const TOP = 26;
const LX = 8;
const LW = 250;
const MX = 380;
---

<svg
  class="viz"
  data-viz="crime"
  viewBox={`0 0 ${W} ${TOP + VARS.length * ROW + 40}`}
  role="img"
  aria-label={t(lang, 'viz.crime.model.aria')}
>
  <text class="viz-label" x={LX} y="14">{t(lang, 'viz.crime.model.inputs')}</text>
  <text class="viz-label" x={MX + 30} y="14">{t(lang, 'viz.crime.model.model')}</text>

  {
    VARS.map((v, i) => {
      const cy = TOP + i * ROW + 8;
      return (
        <g data-var={i} opacity="0">
          <text
            class="viz-value"
            x={LX}
            y={cy + 4}
            style={`font-size:12px; fill: var(${v.sig ? '--ink' : '--ink-faint'})`}
          >
            {v.name}
          </text>
          {v.struck && (
            <line
              class="viz-limit"
              data-strike
              x1={LX - 2}
              y1={cy}
              x2={LX + 78}
              y2={cy}
              stroke-width="1"
            />
          )}
          {v.p && (
            <text
              class="viz-label"
              x={LX + LW}
              y={cy + 4}
              text-anchor="end"
              style={v.sig ? 'fill: var(--rubric)' : 'fill: var(--ink-faint)'}
            >
              {v.p}
            </text>
          )}
          <path
            class={v.sig ? 'viz-accent' : 'viz-track'}
            data-edge
            d={`M ${LX + LW + 12} ${cy} C ${MX - 40} ${cy} ${MX - 40} ${TOP + 2 * ROW + 8} ${MX} ${TOP + 2 * ROW + 8}`}
          />
        </g>
      );
    })
  }

  <rect class="viz-box" x={MX} y={TOP + ROW + 2} width="150" height="52" rx="2"></rect>
  <text class="viz-value" x={MX + 75} y={TOP + ROW + 24} text-anchor="middle">R² 0.843</text>
  <text class="viz-label" x={MX + 75} y={TOP + ROW + 40} text-anchor="middle">
    {t(lang, 'viz.crime.model.adjusted')}
  </text>

  <path
    class="viz-ink"
    d={`M ${MX + 150} ${TOP + 2 * ROW + 8} L ${W - 130} ${TOP + 2 * ROW + 8}`}></path>
  <text class="viz-value" x={W - 122} y={TOP + 2 * ROW + 4} style="font-size:12px">
    {t(lang, 'viz.crime.model.outcome')}
  </text>
  <text class="viz-label" x={W - 122} y={TOP + 2 * ROW + 18}>{t(lang, 'viz.crime.model.n')}</text>

  <text class="viz-label" x={LX} y={TOP + VARS.length * ROW + 26}>
    {t(lang, 'viz.crime.model.foot')}
  </text>
</svg>
