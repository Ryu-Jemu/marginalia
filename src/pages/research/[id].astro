---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/chrome/Nav.astro';
import NoteLines from '../../components/note/NoteLines.astro';
import Section from '../../components/doc/Section.astro';
import Bullets from '../../components/doc/Bullets.astro';
import Materials from '../../components/research/Materials.astro';
import ResearchFigures from '../../components/research/ResearchFigures.astro';
import N from '../../components/note/N.astro';
import { resolveMaterials } from '../../lib/materials';
import { site } from '../../lib/site';

export const prerender = true;

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const r = entry.data;
const materials = resolveMaterials(r.materials);

const ORDINAL = ['', 'first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh'];
const authorship =
  r.authorPosition.of === 1
    ? 'Sole author'
    : r.authorPosition.index === 1
      ? `First author of ${r.authorPosition.of}`
      : `Co-author — ${ORDINAL[r.authorPosition.index] ?? r.authorPosition.index} of ${r.authorPosition.of}`;

const STATUS = {
  accepted: 'Accepted',
  'under-review': 'Under review',
  revision: 'In revision',
  assisting: 'Lab work',
} as const;

let n = 0;
const next = () => String(++n);
---

<Base title={`${r.title} — ${site.name}`} description={r.summary ?? r.title}>
  <Nav base="/" />

  <main class="shell">
    <article class="document" data-annotated>
      <NoteLines />

      <header class="column column--wide head">
        <p class="head__back"><a href="/#research">&larr; Back</a></p>
        <p class="meta head__meta">
          <span class="head__authorship">{authorship}</span>
          <span class="head__sep">·</span>
          <span class:list={['head__status', `head__status--${r.status}`]}>{STATUS[r.status]}</span>
          <span class="head__sep">·</span>
          <span>{r.date}</span>
        </p>
        <h1 class="head__title">{r.title}</h1>
        <p class="head__venue">{r.venue}</p>

        {
          r.contribution && (
            <p class="head__contribution">
              <span class="head__contribution-key">My part</span>
              {r.contribution}
            </p>
          )
        }

        {
          (r.manuscriptId || r.grant || r.award) && (
            <p class="head__ids">
              {r.award && <span class="head__award">{r.award}</span>}
              {r.manuscriptId && <span>{r.manuscriptId}</span>}
              {r.grant && <span>{r.grant}</span>}
            </p>
          )
        }
      </header>

      {
        r.summary && (
          <div class="column head__summary">
            <p>{r.summary}</p>
          </div>
        )
      }

      {
        r.role.length > 0 && (
          <Section id="role" n={next()} title="What I did">
            <div class="column column--wide">
              <Bullets items={r.role} tone="ink" />
            </div>
          </Section>
        )
      }

      {
        r.method.length > 0 && (
          <Section id="method" n={next()} title="How it was set up">
            <div class="column column--wide">
              <Bullets items={r.method} />
            </div>
          </Section>
        )
      }

      {
        r.findings.length > 0 && (
          <Section id="findings" n={next()} title="What it found">
            <div class="column column--wide">
              <Bullets items={r.findings} tone="ink" />
            </div>

            <div class="column column--wide chart">
              <ResearchFigures id={entry.id} />
            </div>

            {
              entry.id === 'ask-2026' && (
                <div class="column">
                  <p class="aside">
                    The control is the number worth defending: the same policy trained without
                    foresight lands level with the baseline at every setting.<N id="rl-myopic" />
                  </p>
                </div>
              )
            }
          </Section>
        )
      }

      {
        materials.length > 0 && (
          <Section
            id="materials"
            n={next()}
            title="The paper"
            lede="Held on this site, so it can be read without leaving the page."
          >
            <div class="column column--wide">
              <Materials items={materials} />
            </div>
          </Section>
        )
      }
    </article>
  </main>
</Base>

<style>
  main {
    padding-block: 1.75rem 5rem;
  }
  .head__back {
    font-family: var(--family-mono);
    font-size: var(--t-data);
    margin-bottom: 1.5rem;
  }
  .head__back a {
    color: var(--ink-faint);
    text-decoration: none;
  }
  .head__back a:hover {
    color: var(--rubric);
  }
  .head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.6rem;
  }
  .head__authorship {
    color: var(--rubric);
  }
  .head__sep {
    color: var(--rule-strong);
  }
  .head__status--under-review,
  .head__status--revision {
    color: var(--boundary);
  }
  .head__title {
    font-size: clamp(1.75rem, 2.2vw + 1rem, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.024em;
    font-weight: 600;
  }
  .head__venue {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    font-style: italic;
    font-size: var(--t-lede);
  }
  .head__contribution {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--family-mono);
    font-size: var(--t-data);
    color: var(--ink);
  }
  .head__contribution-key {
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--rubric);
  }
  .head__ids {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 0.7rem;
    font-family: var(--family-mono);
    font-size: var(--t-data);
    color: var(--ink-faint);
  }
  .head__award {
    color: var(--rubric);
  }
  .head__summary {
    margin-top: 1rem;
    color: var(--ink-muted);
    font-size: var(--t-lede);
    line-height: var(--lh-lede);
  }
  .chart {
    margin-top: 1.25rem;
  }
  .aside {
    margin-top: 0.8rem;
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }
</style>
