---
import { Image } from 'astro:assets';
import { t, type Lang } from '../../i18n/ui';

import cinemaMap from '../../assets/analysis/cinema/theatre-map.png';

/**
 * What the studies produced that the site cannot redraw.
 *
 * Every other figure here is rebuilt in code from the study's own numbers, so
 * the plate and the sentence beside it cannot drift apart. What is left in this
 * file is the one output that has no numbers to rebuild from: the theatre map
 * was geocoded through an address API at run time and the coordinates were
 * never written down, so redrawing it would mean geocoding the country again
 * and calling the result the same map.
 *
 * The caption names the script that produced it, so a reviewer can go from the
 * plate to the file.
 */
interface Props {
  slug: string;
  lang?: Lang;
}
const { slug, lang = 'en' } = Astro.props;

/* `quality: 70` on every plate: a map screenshot is mostly texture, and
   encoding one at full fidelity costs half a megabyte for detail nobody
   reads. */
interface Plate {
  src: ImageMetadata;
  key: string;
  /** The file in the study's own repository that drew it. */
  script: string;
  /** Landscape plates take the full width; square ones share a row. */
  wide?: boolean;
}

const SETS: Record<string, Plate[]> = {
  'cinema-dashboard': [
    { src: cinemaMap, key: 'plate.cinema.map', script: 'Array_adress.py', wide: true },
  ],
};

const plates = SETS[slug] ?? [];
---

{
  plates.length > 0 && (
    <div class="plates" data-notes-inline>
      {plates.map((p) => (
        <figure class:list={['plate', p.wide && 'plate--wide']}>
          <Image
            class="plate__img"
            src={p.src}
            alt={t(lang, p.key)}
            widths={[640, 1280]}
            sizes="(max-width: 46rem) 92vw, 40rem"
            loading="lazy"
            quality={70}
          />
          <figcaption class="plate__caption">
            {t(lang, p.key)}
            <span class="plate__script">{p.script}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

<style>
  .plates {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 52rem) {
    .plates {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
    }
    /* A wide plate is one whose x axis carries years or regions: squeezed to
       half the measure its tick labels collide. */
    .plate--wide {
      grid-column: 1 / -1;
    }
  }
  .plate {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .plate__img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: #fff;
  }
  .plate__caption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .plate__script {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    color: var(--scope);
  }
</style>
