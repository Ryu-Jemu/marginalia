---
/**
 * The MAP race, on a time axis.
 *
 * Two writes for one job. In the broken ordering the completion lands first and
 * the late in_progress overwrites it, so the row ends terminal-then-not and the
 * client waits forever. In the fixed ordering the same arrival order produces
 * the same final state, which is the whole point of the rule.
 */
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const W = 620;
const AX = 96; // label column
const T0 = 130;
const T1 = 250;
const T2 = 480;
---

<svg
  class="viz"
  data-viz="race"
  viewBox={`0 0 ${W} 210`}
  role="img"
  aria-label={t(lang, 'viz.race.aria')}
>
  <!-- before -->
  <text class="viz-label" x="0" y="30">{t(lang, 'viz.race.before')}</text>
  <line class="viz-track" x1={AX} y1="44" x2={W - 30} y2="44"></line>

  <g data-row="before">
    <circle class="viz-fill-ink" cx={T0} cy="44" r="4"></circle>
    <text class="viz-label" x={T0} y="30" text-anchor="middle">completed</text>
    <text class="viz-label" x={T0} y="60" text-anchor="middle">{t(lang, 'viz.race.first')}</text>

    <circle class="viz-fill-boundary" cx={T1} cy="44" r="4"></circle>
    <text class="viz-label" x={T1} y="30" text-anchor="middle">in_progress</text>
    <text class="viz-label" x={T1} y="60" text-anchor="middle">{t(lang, 'viz.race.late')}</text>

    <!-- the overwrite -->
    <path
      class="viz-limit"
      data-overwrite
      d={`M ${T1} 44 C ${T1 - 30} 12 ${T0 + 30} 12 ${T0 + 6} 40`}
      marker-end="url(#arrow-limit)"></path>

    <rect class="viz-box" x={T2 - 60} y="28" width="132" height="32" rx="2"></rect>
    <text class="viz-value viz-value--boundary" x={T2 + 6} y="49" text-anchor="middle">
      in_progress
    </text>
    <text class="viz-label" x={T2 + 6} y="76" text-anchor="middle" style="fill: var(--boundary)">
      {t(lang, 'viz.race.stuck')}
    </text>
  </g>

  <!-- after -->
  <text class="viz-label" x="0" y="146">{t(lang, 'viz.race.after')}</text>
  <line class="viz-track" x1={AX} y1="160" x2={W - 30} y2="160"></line>

  <g data-row="after">
    <circle class="viz-fill-ink" cx={T0} cy="160" r="4"></circle>
    <text class="viz-label" x={T0} y="146" text-anchor="middle">completed</text>
    <text class="viz-label" x={T0} y="176" text-anchor="middle">{t(lang, 'viz.race.first')}</text>

    <circle class="viz-fill-ink" cx={T1} cy="160" r="4"></circle>
    <text class="viz-label" x={T1} y="146" text-anchor="middle">in_progress</text>
    <text class="viz-label" x={T1} y="176" text-anchor="middle">{t(lang, 'viz.race.guard')}</text>

    <!-- the write that does not happen -->
    <g data-blocked>
      <line class="viz-limit" x1={T1 - 9} y1="151" x2={T1 + 9} y2="169"></line>
      <line class="viz-limit" x1={T1 + 9} y1="151" x2={T1 - 9} y2="169"></line>
    </g>

    <rect class="viz-box" x={T2 - 60} y="144" width="132" height="32" rx="2"></rect>
    <text class="viz-value viz-value--rubric" x={T2 + 6} y="165" text-anchor="middle">
      completed
    </text>
    <text class="viz-label" x={T2 + 6} y="192" text-anchor="middle">{t(lang, 'viz.race.terminal')}</text>
  </g>

  <defs>
    <marker id="arrow-limit" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M 0 1 L 7 4 L 0 7 z" fill="var(--boundary)"></path>
    </marker>
  </defs>
</svg>
