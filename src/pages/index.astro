---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/chrome/Nav.astro';
import Masthead from '../components/chrome/Masthead.astro';
import NoteLines from '../components/note/NoteLines.astro';
import N from '../components/note/N.astro';
import Section from '../components/doc/Section.astro';
import ProjectEntry from '../components/work/ProjectEntry.astro';
import PipelineProject from '../components/work/PipelineProject.astro';
import CompactList from '../components/work/CompactList.astro';
import PaperEntry from '../components/research/PaperEntry.astro';
import Figure from '../components/viz/Figure.astro';
import PipelineFlow from '../components/viz/PipelineFlow.astro';
import RaceTimeline from '../components/viz/RaceTimeline.astro';
import SilentLoss from '../components/viz/SilentLoss.astro';
import PricingChart from '../components/viz/PricingChart.astro';
import CrimeModel from '../components/viz/CrimeModel.astro';
import { site } from '../lib/site';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const projects = (await getCollection('projects')).sort(byOrder);
const bySlug = (slug: string) => projects.find((p) => p.id.replace(/^tier2\//, '') === slug)!;
const inDomain = (d: string) => projects.filter((p) => p.data.domain === d);

const dartoo = bySlug('dartoo');
const map = bySlug('map');
const researchBuilds = inDomain('research');
const analysis = inDomain('analysis');
const other = inDomain('other');

const research = await getCollection('research');
const record = await getCollection('record');

/** Most recent first. The dates are `YYYY.MM` strings, which sort lexically. */
const newestFirst = (a: { data: { date: string } }, b: { data: { date: string } }) =>
  b.data.date.localeCompare(a.data.date);

const byKind = (kind: string) => record.filter((r) => r.data.kind === kind).sort(newestFirst);
const awards = byKind('award');
const certifications = byKind('certification');
const history = record
  .filter((r) => ['education', 'service', 'lab', 'teaching', 'writing'].includes(r.data.kind))
  .sort(newestFirst);
---

<Base
  title={`${site.name} — ${site.role}`}
  description="Data pipelines, wireless-optimisation research, and statistical analysis — with the measurement conditions in the margin beside every figure."
>
  <Nav />

  <main class="shell">
    <article class="document" data-annotated>
      <NoteLines />

      <Masthead />

      {/* Three domains, stated once, so the rest of the page has a shape. */}
      <section class="intro">
        <div class="column column--wide">
          <ol class="domains">
            <li>
              <a href="#pipelines"><span class="domains__n">01</span> Data pipelines</a>
              <p>
                Two products where I owned the path the data takes — collected, decoded, cached,
                modelled and delivered.
              </p>
            </li>
            <li>
              <a href="#research"><span class="domains__n">02</span> Research</a>
              <p>
                Two papers. First author on a pricing paper that took a silver award; the beam
                prediction section of a survey under review at IEEE TAI.
              </p>
            </li>
            <li>
              <a href="#analysis"><span class="domains__n">03</span> Data analysis</a>
              <p>
                Two studies where the data contradicted the premise the project started from —
                Seoul crime, and multiplex revenue.
              </p>
            </li>
          </ol>
        </div>
      </section>

      {/* ── § 1 ─────────────────────────────────────────────────────── */}
      <Section
        id="pipelines"
        n="1"
        title="Data pipelines"
        lede="Two team products, nine services owned between them. Each one is a path data takes from an external source to a phone, and the parts of it that broke quietly are listed with what fixed them."
      >
        <div class="column">
          <p class="aside aside--lead">
            The defects worth opening with were all quiet ones. A publisher that reported success
            while delivering nothing; a finished job that walked backwards into “in
            progress”;<N id="map-terminal-state" /> source archives arriving in three encodings,
            some declaring none at all.<N id="dartoo-normaliser" /> None of them showed in a status
            code.
          </p>
        </div>

        <div class="column column--wide">
          <Figure n="1" title="Dartoo — five stages from the filing system to a push notification.">
            <PipelineFlow
              from="Regulatory filing system"
              to="Phone"
              stages={[
                { name: 'Poll', detail: 'ingestion' },
                { name: 'Decode', detail: 'normalise' },
                { name: 'Store', detail: 'disclosure' },
                { name: 'Summarise', detail: 'summary' },
                { name: 'Deliver', detail: 'notification' },
              ]}
            />
          </Figure>
        </div>

        <PipelineProject entry={dartoo} />

        <div class="column column--wide">
          <Figure
            n="2"
            title="One service, two lanes. Every request returned 200 and only one lane delivered."
          >
            <SilentLoss />
          </Figure>
        </div>

        <div class="column column--wide project-gap">
          <Figure n="3" title="MAP — five external feeds, filtered before the model sees them.">
            <PipelineFlow
              from="Five external feeds"
              to="Itinerary"
              stages={[
                { name: 'Poll', detail: 'scheduled prefetch' },
                { name: 'Cache', detail: 'Redis L1' },
                { name: 'Filter', detail: 'rule engine' },
                { name: 'Choose', detail: 'model' },
                { name: 'Verify', detail: 'contract check' },
              ]}
            />
          </Figure>
        </div>

        <PipelineProject entry={map} />

        <div class="column column--wide">
          <Figure n="4" title="The same two writes, before and after the rule.">
            <RaceTimeline />
          </Figure>
        </div>
      </Section>

      {/* ── § 2 ─────────────────────────────────────────────────────── */}
      <Section
        id="research"
        n="2"
        title="Research"
        lede="Author position is stored as a number and rendered from it, so it cannot drift into a stronger claim."
      >
        <div class="column">
          {research.map((entry) => <PaperEntry entry={entry} />)}
        </div>

        <div class="column column--wide">
          <Figure n="5" title="Revenue over the max-price baseline, by churn sensitivity. The m=1 bar is faint because it is not significant.">
            <PricingChart />
          </Figure>
        </div>

        <div class="column">
          <p class="aside aside--lead">
            The figure I would defend is not the largest one. It is the control: the same policy
            trained without foresight lands level with the baseline at every
            setting.<N id="rl-myopic" />
          </p>
        </div>

        <div class="column">
          {researchBuilds.map((entry) => <ProjectEntry entry={entry} compact />)}
        </div>
      </Section>

      {/* ── § 3 ─────────────────────────────────────────────────────── */}
      <Section
        id="analysis"
        n="3"
        title="Data analysis"
        lede="Collection, cleaning, the model, and the check that the model is worth reading."
      >
        <div class="column">
          {analysis.map((entry) => <ProjectEntry entry={entry} compact />)}
        </div>

        <div class="column column--wide">
          <Figure n="6" title="Five inputs, one model. The variable the project set out to confirm is the one that failed.">
            <CrimeModel />
          </Figure>
        </div>
      </Section>

      {/* ── § 4 ─────────────────────────────────────────────────────── */}
      <Section
        id="more"
        n="4"
        title="More work"
        lede="Services, spikes and coursework, listed as they stand."
      >
        <div class="column">
          <p class="aside aside--lead">
            Twelve repositories of my own, plus the services owned inside two team
            organisations.<N id="repo-spread" /> Three of them exist only to settle a question
            before it reached a real service.<N id="poc-habit" />
          </p>
        </div>
        <div class="column column--wide">
          <CompactList entries={other} />
        </div>
      </Section>

      {/* ── § 5 ─────────────────────────────────────────────────────── */}
      <Section id="about" n="5" title="About" lede="Awards, certifications, and the path here.">
        <div class="column column--wide">
          <div class="record__grid">
            <div>
              <h3 class="record__group">Awards and selections</h3>
              <ul class="record">
                {
                  awards.map((r) => (
                    <li class="record__row">
                      <span class="record__date">{r.data.date}</span>
                      <span class="record__body">
                        <strong>{r.data.title}</strong>
                        <span class="record__issuer">{r.data.issuer}</span>
                        {r.data.detail && <span class="record__detail">{r.data.detail}</span>}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="record__group">Certifications</h3>
              <ul class="record">
                {
                  certifications.map((r) => (
                    <li class="record__row">
                      <span class="record__date">{r.data.date}</span>
                      <span class="record__body">
                        <strong>{r.data.title}</strong>
                        <span class="record__issuer">
                          {r.data.issuer}
                          {r.data.score && ` · ${r.data.score}`}
                        </span>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <h3 class="record__group record__group--wide">Education and service</h3>
          <ul class="record record--two">
            {
              history.map((r) => (
                <li class="record__row">
                  <span class="record__date">{r.data.date}</span>
                  <span class="record__body">
                    <strong>
                      {r.data.href ? (
                        <a href={r.data.href} rel="noopener">
                          {r.data.title}
                        </a>
                      ) : (
                        r.data.title
                      )}
                    </strong>
                    <span class="record__issuer">{r.data.issuer}</span>
                    {r.data.detail && <span class="record__detail">{r.data.detail}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </Section>

      {/* ── contact ─────────────────────────────────────────────────── */}
      <section id="contact" class="contact-block">
        <div class="column column--wide">
          <h2 class="contact__head">Contact</h2>
          <ul class="contact">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.links.github} rel="noopener">github.com/Ryu-Jemu</a></li>
            <li><a href={site.links.blog} rel="noopener">velog.io/@muqqi_bba</a></li>
          </ul>
        </div>
      </section>
    </article>
  </main>
</Base>

<style>
  main {
    padding-block: 1.5rem 4rem;
  }

  /* ── the three domains, as a table of contents ─────────────────────── */
  .intro {
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .domains {
    display: grid;
    gap: 1rem 1.75rem;
  }
  @media (min-width: 40rem) {
    .domains {
      grid-template-columns: repeat(3, 1fr);
      gap: 0 2rem;
    }
  }
  .domains a {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }
  .domains a:hover {
    color: var(--rubric);
  }
  .domains__n {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    color: var(--rubric);
    letter-spacing: 0;
  }
  .domains p {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-faint);
    text-wrap: pretty;
  }

  .project-gap {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .aside {
    margin-top: 1rem;
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }
  .aside--lead {
    margin-top: 0;
    margin-bottom: 1.1rem;
  }

  /* ── record ────────────────────────────────────────────────────────── */
  .record__grid {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 44rem) {
    .record__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem;
    }
  }
  .record__group {
    margin-bottom: 0.7rem;
    font-family: var(--family-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--scope);
    font-weight: 500;
  }
  .record__group--wide {
    margin-top: 1.75rem;
  }
  .record {
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 44rem) {
    .record--two {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 2.25rem;
    }
  }
  .record__row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.15rem 0.85rem;
    align-items: baseline;
  }
  @media (max-width: 30rem) {
    .record__row {
      grid-template-columns: 1fr;
    }
  }
  .record__date {
    font-family: var(--family-mono);
    font-size: var(--t-data);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .record__body {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    font-size: 0.9375rem;
  }
  .record__issuer,
  .record__detail {
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .record__detail {
    color: var(--ink-faint);
  }

  /* ── contact ───────────────────────────────────────────────────────── */
  .contact-block {
    margin-top: var(--space-section);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .contact__head {
    font-size: var(--t-h3);
  }
  .contact {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-family: var(--family-mono);
    font-size: var(--t-data);
  }
</style>
