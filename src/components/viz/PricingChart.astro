---
/**
 * The paper's result, at the scale it actually has.
 *
 * The prose states these four numbers; the chart is here so the shape of them
 * is visible — flat and insignificant at m=1, then climbing. The m=1 bar is
 * drawn in the limit colour and labelled n.s., because a chart that renders it
 * like the others would be making a claim the statistics do not support.
 */
const DATA = [
  { m: 1, uplift: 2.1, sig: false, p: 'p = 0.472' },
  { m: 3, uplift: 105.8, sig: true, p: 'p < 0.001' },
  { m: 5, uplift: 195.8, sig: true, p: 'p < 0.001' },
  { m: 10, uplift: 363.2, sig: true, p: 'p < 0.001' },
];

const W = 620;
const H = 250;
const PAD_L = 52;
const PAD_R = 70;
const PAD_T = 18;
const BASE = 200;
const MAX = 400;
const band = (W - PAD_L - PAD_R) / DATA.length;
const barW = 34;
const y = (v: number) => BASE - (v / MAX) * (BASE - PAD_T);
---

<svg
  class="viz"
  data-viz="pricing"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="Revenue uplift over a max-price baseline by churn sensitivity: 2.1 percent at m=1 and not significant, then 105.8, 195.8 and 363.2 percent at m=3, 5 and 10, each significant at p below 0.001."
>
  <!-- gridlines -->
  {
    [0, 100, 200, 300, 400].map((v) => (
      <g>
        <line class="viz-track" x1={PAD_L} y1={y(v)} x2={W - PAD_R} y2={y(v)} />
        <text class="viz-label" x={PAD_L - 8} y={y(v) + 3} text-anchor="end">
          {v}%
        </text>
      </g>
    ))
  }

  <!-- the baseline the comparison is against -->
  <line class="viz-rule" x1={PAD_L} y1={y(0)} x2={W - PAD_R} y2={y(0)}></line>

  {
    DATA.map((d, i) => {
      const cx = PAD_L + band * i + band / 2;
      const top = y(d.uplift);
      return (
        <g data-bar={i}>
          <rect
            class={d.sig ? 'viz-fill-accent' : 'viz-fill-boundary'}
            data-bar-rect
            x={cx - barW / 2}
            y={top}
            width={barW}
            height={Math.max(0, BASE - top)}
            opacity={d.sig ? 1 : 0.45}
          />
          <text class="viz-value" data-bar-value x={cx} y={top - 8} text-anchor="middle">
            {d.uplift}%
          </text>
          <text class="viz-label" x={cx} y={BASE + 16} text-anchor="middle">
            m = {d.m}
          </text>
          <text
            class="viz-label"
            x={cx}
            y={BASE + 30}
            text-anchor="middle"
            style={d.sig ? '' : 'fill: var(--boundary)'}
          >
            {d.sig ? d.p : 'n.s.'}
          </text>
        </g>
      );
    })
  }

  <!-- the decomposition the headline number hides -->
  <g data-attribution opacity="0">
    <line
      class="viz-limit"
      x1={PAD_L + band * 1 + band / 2 + barW / 2 + 6}
      y1={y(105.8)}
      x2={W - PAD_R + 10}
      y2={y(105.8)}
      stroke-dasharray="3 3"></line>
    <text class="viz-label" x={W - PAD_R + 14} y={y(105.8) - 4} style="fill: var(--boundary)">
      97% of this
    </text>
    <text class="viz-label" x={W - PAD_R + 14} y={y(105.8) + 8} style="fill: var(--boundary)">
      is one slice
    </text>
  </g>

  <text class="viz-label" x={PAD_L} y={H - 6}>
    revenue vs max-price baseline · churn sensitivity m · simulation
  </text>
</svg>
