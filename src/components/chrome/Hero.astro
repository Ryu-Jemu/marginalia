---
import { Image } from 'astro:assets';
import Actions from '../work/Actions.astro';
import { site, standing } from '../../lib/site';
import photo from '../../assets/profile/photo.jpg';

/**
 * The hero.
 *
 * One line about the work, the figures that back it, and a way in. The rule
 * beneath it draws itself when the page loads and the figures count up, which
 * is the only decoration on the page that is not also information.
 */
---

<header class="hero" data-hero>
  <div class="shell hero__inner">
    <div class="hero__body">
      <p class="meta hero__eyebrow">{site.role} · {site.status}</p>
      <h1 class="hero__name">{site.name}</h1>
      <p class="hero__lede">{site.lede}</p>

      <ul class="hero__points">
        <li>Two data pipelines carrying a mobile product each — ten services owned between them, and 1,300 automated tests behind them.</li>
        <li>First author on a paper that took a silver award; Section III.E of a survey under review at IEEE TAI.</li>
        <li>Two statistical studies where the data contradicted the premise the project started from.</li>
      </ul>

      <Actions
        actions={[
          { href: '#pipelines', label: 'See the pipelines', kind: 'deployed' },
          { href: `mailto:${site.email}`, label: site.email, kind: 'doc' },
          { href: site.links.github, label: 'GitHub', kind: 'repo' },
        ]}
      />
    </div>

    <Image
      class="hero__photo"
      src={photo}
      alt="Ryu Jemu"
      widths={[240, 480]}
      sizes="12rem"
      loading="eager"
    />
  </div>

  <div class="shell">
    <dl class="hero__figures" data-panel>
      {
        standing.map((s) => (
          <div class="hero__figure">
            <dt class="hero__value" data-countup>
              {s.value}
            </dt>
            <dd class="hero__label">{s.label}</dd>
            <dd class="hero__detail">{s.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</header>

<style>
  .hero {
    padding-block: 2.5rem 1.25rem;
  }
  @media (min-width: 52rem) {
    .hero {
      padding-block: 4rem 1.5rem;
    }
  }

  .hero__inner {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem 2.5rem;
    flex-wrap: wrap;
  }
  .hero__body {
    flex: 1 1 22rem;
    min-width: 0;
  }
  /* Squared off, not a circle: this is a document, and the photo is a plate in
     it rather than an avatar. */
  .hero__photo {
    width: 8rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 22%;
    border: 1px solid var(--rule);
    border-radius: 2px;
    flex: none;
  }
  @media (min-width: 52rem) {
    .hero__photo {
      width: 11rem;
    }
  }

  .hero__eyebrow {
    margin-bottom: 0.6rem;
  }
  .hero__name {
    font-size: clamp(2.5rem, 5vw + 1rem, 4.25rem);
    line-height: 1;
    letter-spacing: -0.032em;
    font-weight: 600;
  }
  .hero__lede {
    margin-top: 0.9rem;
    font-size: clamp(1.125rem, 0.9vw + 0.9rem, 1.4375rem);
    line-height: 1.4;
    letter-spacing: -0.014em;
    color: var(--ink-muted);
    max-width: 34ch;
    text-wrap: pretty;
  }

  .hero__points {
    margin-top: 1.2rem;
    display: grid;
    gap: 0.3rem;
    max-width: 52ch;
  }
  .hero__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .hero__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: 1px;
    background: var(--rubric);
  }

  .hero__figures {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.25rem, 1fr));
    gap: 0.9rem 1.5rem;
  }
  .hero__figure {
    display: flex;
    flex-direction: column;
  }
  .hero__value {
    font-size: 1.75rem;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .hero__label {
    margin: 0.3rem 0 0;
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .hero__detail {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-faint);
    text-wrap: pretty;
  }
</style>
