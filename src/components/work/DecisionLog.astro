---
import N from '../note/N.astro';

interface Decision {
  decision: string;
  why: string;
  rejected: string[];
  notDone: string[];
  notes: string[];
}

interface Props {
  decisions: Decision[];
}

const { decisions } = Astro.props;
---

<ol class="log">
  {
    decisions.map((d, i) => (
      <li class="log__item">
        <p class="meta log__n">D{String(i + 1).padStart(2, '0')}</p>
        <h3 class="log__decision">{d.decision}</h3>

        <p class="log__why">
          {d.why}
          {d.notes.map((id) => (
            <N id={id} />
          ))}
        </p>

        {d.rejected.length > 0 && (
          <div class="log__block">
            <p class="meta log__key">Rejected</p>
            <ul class="log__list">
              {d.rejected.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </div>
        )}

        {d.notDone.length > 0 && (
          <div class="log__block log__block--not-done">
            <p class="meta log__key">Not done</p>
            <ul class="log__list">
              {d.notDone.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .log {
    display: grid;
    gap: 1.4rem;
  }
  .log__item {
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .log__n {
    color: var(--rubric);
    margin-bottom: 0.4rem;
  }
  .log__decision {
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: -0.012em;
    font-weight: 600;
  }
  .log__why {
    margin-top: 0.55rem;
    color: var(--ink-muted);
  }
  .log__block {
    margin-top: 0.9rem;
  }
  .log__key {
    color: var(--scope);
    margin-bottom: 0.3rem;
  }
  /* What was not done is marked in the limit colour, not the neutral one. */
  .log__block--not-done .log__key {
    color: var(--boundary);
  }
  .log__list {
    display: grid;
    gap: 0.3rem;
    font-size: 0.95em;
    color: var(--ink-muted);
  }
  .log__list li {
    position: relative;
    padding-left: 1rem;
  }
  .log__list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rule-strong);
  }
</style>
