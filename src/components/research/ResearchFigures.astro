---
import Figure from '../viz/Figure.astro';
import PricingChart from '../viz/PricingChart.astro';
import PricingAlgorithms from '../viz/PricingAlgorithms.astro';
import BeamArchitecture from '../viz/BeamArchitecture.astro';
import BeamGain from '../viz/BeamGain.astro';
import BeamOverhead from '../viz/BeamOverhead.astro';
import BeamTraining from '../viz/BeamTraining.astro';
import { platesFor, type Plate } from '../../lib/figures';
import { t, type Lang } from '../../i18n/ui';

/**
 * The plates that belong to a given paper.
 *
 * Every one is drawn from the manuscript's own published values rather than
 * lifted as an image, so the numbers on the page and the numbers in the paper
 * are the same numbers.
 *
 * `part` splits them between the two places a paper's page has for a plate:
 * what the paper found, and what the code behind it did. Which plates go where
 * is `lib/figures.ts`, which the page also reads to keep the numbering
 * continuous across the two.
 */
interface Props {
  id: string;
  part?: 'findings' | 'implementation';
  startAt?: number;
  lang?: Lang;
}
const { id, part = 'findings', startAt = 0, lang = 'en' } = Astro.props;

const CAPTION: Record<Plate, string> = {
  pricing: 'fig.pricing',
  pricingAlgorithms: 'fig.pricing.alg',
  beamGain: 'fig.beam.gain',
  beamOverhead: 'fig.beam.overhead',
  beamArchitecture: 'fig.beam.arch',
  beamTraining: 'fig.beam.train',
};

const plates = platesFor(id, part);
---

{
  plates.map((plate, i) => (
    <Figure n={String(startAt + i + 1)} title={t(lang, CAPTION[plate])} lang={lang}>
      {plate === 'pricing' && <PricingChart lang={lang} />}
      {plate === 'pricingAlgorithms' && <PricingAlgorithms lang={lang} />}
      {plate === 'beamGain' && <BeamGain lang={lang} />}
      {plate === 'beamOverhead' && <BeamOverhead lang={lang} />}
      {plate === 'beamArchitecture' && <BeamArchitecture lang={lang} />}
      {plate === 'beamTraining' && <BeamTraining lang={lang} />}
    </Figure>
  ))
}
