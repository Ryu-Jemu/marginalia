---
import Figure from './Figure.astro';
import SilentLoss from './SilentLoss.astro';
import RaceTimeline from './RaceTimeline.astro';
import RouteStages from './RouteStages.astro';
import PricingChart from './PricingChart.astro';
import CrimeModel from './CrimeModel.astro';

/**
 * Which plates belong to which project. Kept out of the content files so the
 * MDX stays prose, and out of the schema so a figure is a rendering decision
 * rather than a data one.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{
  slug === 'dartoo' && (
    <Figure n="1" title="One service, two lanes. Every request returned 200 and only one lane delivered.">
      <SilentLoss />
    </Figure>
  )
}

{
  slug === 'map' && (
    <>
      <Figure n="1" title="The same two writes, before and after the rule.">
        <RaceTimeline />
      </Figure>
      <Figure n="2" title="Three stages. The model only reorders a route the deterministic stages produced.">
        <RouteStages />
      </Figure>
    </>
  )
}

{
  slug === 'network-pricing' && (
    <Figure n="1" title="Revenue over the max-price baseline, by churn sensitivity. The m=1 bar is faint because it is not significant.">
      <PricingChart />
    </Figure>
  )
}

{
  slug === 'crime-analysis' && (
    <Figure n="1" title="Five inputs, one model. The variable the project set out to confirm is the one that failed.">
      <CrimeModel />
    </Figure>
  )
}
