---
/** A limit, drawn at the same weight as a result. The amber frame is stroked
 *  by anime.js on entry — the same technique as the leader lines, in the other
 *  colour, so the visual language distinguishes a finding from its edge. */
interface Props { claim: string }
const { claim } = Astro.props;
---

<div class="boundary" data-boundary>
  <svg class="boundary__frame" aria-hidden="true" focusable="false" preserveAspectRatio="none">
    <rect x="0.5" y="0.5" rx="2"></rect>
  </svg>
  <p class="boundary__claim">{claim}</p>
  <div class="boundary__detail"><slot /></div>
</div>

<style is:global>
  .boundary {
    position: relative;
    padding: 1.1rem 1.25rem;
    margin-block: 1.1rem;
  }
  .boundary__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .boundary__frame rect {
    width: calc(100% - 1px);
    height: calc(100% - 1px);
    fill: none;
    stroke: var(--boundary);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.55;
  }
  .boundary__claim {
    font-weight: 600;
    color: var(--boundary);
  }
  .boundary__detail {
    margin-top: 0.45rem;
    color: var(--ink-muted);
    font-size: 0.95em;
  }
  .boundary__detail p + p { margin-top: 0.6em; }
</style>
