---
import Base from '../../layouts/Base.astro';
import '../../styles/detail.css';
import type {Research} from '../../lib/content';
import FlowDiagram from '../viz/FlowDiagram.astro';
import ResearchVisual from '../viz/ResearchVisual.astro';
import PricingResults from '../viz/PricingResults.astro';
import BeamMethodStudy from '../viz/BeamMethodStudy.astro';
import TechnologyChoices from '../TechnologyChoices.astro';
import { technologyChoices } from '../../data/project-technology';
import Icon from '../Icon.astro';
interface Props { paper: Research }
const {paper} = Astro.props;
const p = paper.data;
const linkIcon = (href: string): 'code' | 'book' | 'link' => href.includes('github.com/') ? 'code' : /\.pdf(?:[?#]|$)/.test(href) ? 'book' : 'link';
---
<Base title={`${p.shortTitle} · 류제무 포트폴리오`} description={p.question}>
  <div class="wrap detail-wrap document-detail">
    <header class="detail-header">
      <a class="back-link" href="/#research">← 모든 연구</a>
      <div class="project-kicker"><span>{p.venue}</span><span>{p.status === 'accepted' ? '논문 채택' : '심사 중'}</span></div>
      <h1 class="paper-title">{p.title}</h1>
      <p class="detail-role"><strong>{p.authorPosition.index === 1 ? '제1저자' : '공동저자'}</strong><span>전체 {p.authorPosition.of}명 중 {p.authorPosition.index}번째 저자</span></p>
      <div class="detail-links">
        {p.materials.map(l => <a href={l.href}><Icon name={linkIcon(l.href)} size={18}/>{l.label}<Icon name="arrow-up-right" size={15}/></a>)}
        <a href={`/work/${p.project}/`}><Icon name="code" size={18}/>구현 프로젝트<Icon name="arrow-up-right" size={15}/></a>
      </div>
    </header>

    <div class="detail-layout">
      <aside class="detail-sidebar">
        <nav class="detail-nav" aria-label="연구 목차" data-section-nav>
          <span class="detail-nav-title">목차</span>
          <a href="#question"><Icon name="target" size={17}/>질문</a>
          <a href="#method"><Icon name="route" size={17}/>방법</a>
          <a href="#role"><Icon name="user" size={17}/>기여</a>
          <a href="#technology"><Icon name="code" size={17}/>기술</a>
          <a href="#findings"><Icon name="check" size={17}/>결과</a>
        </nav>
      </aside>

      <div class="detail-body">
        <section class="detail-section detail-question" id="question">
          <h2><Icon name="target" size={22}/>질문</h2>
          <p class="research-question">{p.question}</p>
          <ResearchVisual kind={paper.id === 'ask-2026' ? 'pricing' : 'beam'}/>
        </section>

        <section class="detail-section" id="method">
          <h2><Icon name="route" size={22}/>방법</h2>
          {paper.id === 'ieee-tai-survey' ? <BeamMethodStudy/> : <FlowDiagram stages={p.flow} label={`${p.shortTitle}의 접근 방법`} compact/>}
          <ul class="prose-list research-list">{p.method.map(x => <li>{x}</li>)}</ul>
        </section>

        <section class="detail-section" id="role">
          <h2><Icon name="user" size={22}/>기여</h2>
          <ul class="prose-list">{p.role.map(x => <li>{x}</li>)}</ul>
          <a class="text-link implementation-link" href={`/work/${p.project}/`}><Icon name="code" size={18}/>관련 구현 살펴보기<Icon name="arrow-up-right" size={15}/></a>
        </section>

        <section class="detail-section" id="technology">
          <h2><Icon name="code" size={22}/>기술</h2>
          <TechnologyChoices choices={technologyChoices[p.project]}/>
        </section>

        <section class="detail-section outcomes" id="findings">
          <h2><Icon name="check" size={22}/>결과</h2>
          {paper.id === 'ask-2026' && <PricingResults/>}
          <ul class="prose-list">{p.findings.map(x => <li>{x}</li>)}</ul>
        </section>

        <footer class="detail-bottom"><a class="back-link" href="/#research">← 다른 연구 보기</a></footer>
      </div>
    </div>
  </div>
</Base>
