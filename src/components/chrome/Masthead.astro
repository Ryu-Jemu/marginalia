---
import { Image } from 'astro:assets';
import N from '../note/N.astro';
import Actions from '../work/Actions.astro';
import { site, standing } from '../../lib/site';
import photo from '../../assets/profile/photo.jpg';
---

<header class="masthead">
  <div class="column">
    <div class="masthead__top">
      <Image
        class="masthead__photo"
        src={photo}
        alt="Ryu Jemu"
        widths={[176, 352]}
        sizes="8.5rem"
        loading="eager"
      />
      <div>
        <p class="meta masthead__status">{site.status}</p>
        <h1 class="masthead__name">{site.name}</h1>
        <p class="masthead__lede">{site.lede}</p>
      </div>
    </div>

    <p class="masthead__scope">
      Two of them are deployed mobile products with a team behind
      them.<N id="deployed-scope" />
    </p>
  </div>

  <div class="column column--wide">
    <dl class="standing" data-panel>
      {
        standing.map((s) => (
          <div class="standing__item">
            <dt class="standing__value" data-countup>
              {s.value}
            </dt>
            <dd class="standing__label">{s.label}</dd>
            <dd class="standing__detail">{s.detail}</dd>
          </div>
        ))
      }
    </dl>

    <Actions
      actions={[
        { href: `mailto:${site.email}`, label: 'Email me', kind: 'deployed' },
        { href: site.links.github, label: 'GitHub', kind: 'repo' },
        { href: site.links.blog, label: 'Writing', kind: 'doc' },
      ]}
    />
  </div>
</header>

<style>
  .masthead {
    padding-bottom: 1.1rem;
  }
  .masthead__top {
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
  }
  /* Squared off, not a circle: this is a document, and the photo is a plate in
     it rather than an avatar. */
  .masthead__photo {
    width: 8rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 22%;
    border: 1px solid var(--rule);
    border-radius: 2px;
    flex: none;
  }
  @media (max-width: 30rem) {
    .masthead__top {
      gap: 1rem;
    }
    .masthead__photo {
      width: 5.75rem;
    }
  }
  .masthead__status {
    margin-bottom: 0.45rem;
  }
  .masthead__name {
    /* SF Pro Display at 600 with tight tracking. A masthead, not a poster. */
    font-weight: 600;
  }
  .masthead__lede {
    margin-top: 0.55rem;
    font-size: var(--t-lede);
    line-height: var(--lh-lede);
    font-weight: 400;
    color: var(--ink-muted);
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .masthead__scope {
    margin-top: 0.9rem;
    font-size: 0.875rem;
    color: var(--ink-faint);
  }

  .standing {
    margin-top: 1.1rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.25rem, 1fr));
    gap: 0.85rem 1.5rem;
  }
  .standing__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .standing__value {
    font-size: 1.5rem;
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .standing__label {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0.25rem 0 0;
    text-wrap: pretty;
  }
  .standing__detail {
    margin: 0.1rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-faint);
    text-wrap: pretty;
  }
</style>
