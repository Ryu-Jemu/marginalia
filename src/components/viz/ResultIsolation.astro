---
/** Worker snapshots and personal drafts follow different read paths after the fix. */
import { t, type Lang } from '../../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
---

<svg class="viz isolation" data-viz="result-isolation" viewBox="0 0 1024 380" role="img" aria-label={t(lang, 'viz.isolation.aria')}>
  <g>
    <rect class="isolation__panel" x="1" y="1" width="496" height="372" rx="3" />
    <text class="isolation__eyebrow isolation__problem" x="24" y="29">{t(lang, 'viz.isolation.before')}</text>
    <text class="isolation__title" x="24" y="55">{t(lang, 'viz.isolation.before.title')}</text>

    <path class="isolation__line" d="M 210 117 H 278 m -6 -4 l 6 4 l -6 4" />
    <path class="isolation__line isolation__line--problem" d="M 380 151 V 175 H 116 V 204 m -4 -6 l 4 6 l 4 -6" />
    <path class="isolation__line isolation__line--problem" d="M 210 237 H 278 m -6 -4 l 6 4 l -6 4" />
    <text class="isolation__small" x="241" y="99" text-anchor="middle">{t(lang, 'viz.isolation.edit')}</text>

    <g>
      <rect class="isolation__box" x="24" y="84" width="186" height="67" rx="3" />
      <text class="isolation__label" x="40" y="109">{t(lang, 'viz.isolation.worker')}</text>
      <text class="isolation__value" x="40" y="134">{t(lang, 'viz.isolation.original')}</text>
    </g>
    <g>
      <rect class="isolation__box isolation__box--problem" x="278" y="84" width="194" height="67" rx="3" />
      <rect class="isolation__lit isolation__lit--problem" data-iso-lit="before-edit" x="278" y="84" width="194" height="67" rx="3" opacity="0" />
      <text class="isolation__label" x="294" y="109">{t(lang, 'viz.isolation.user.a')}</text>
      <text class="isolation__value isolation__problem" x="294" y="134">{t(lang, 'viz.isolation.private')}</text>
    </g>
    <g>
      <rect class="isolation__box" x="24" y="204" width="186" height="67" rx="3" />
      <rect class="isolation__lit isolation__lit--problem" data-iso-lit="before-read" x="24" y="204" width="186" height="67" rx="3" opacity="0" />
      <text class="isolation__label" x="40" y="229">{t(lang, 'viz.isolation.lookup')}</text>
      <text class="isolation__value" x="40" y="254">{t(lang, 'viz.isolation.mutable')}</text>
    </g>
    <g>
      <rect class="isolation__box isolation__box--problem" x="278" y="204" width="194" height="67" rx="3" />
      <rect class="isolation__lit isolation__lit--problem" data-iso-lit="before-result" x="278" y="204" width="194" height="67" rx="3" opacity="0" />
      <text class="isolation__label" x="294" y="229">{t(lang, 'viz.isolation.user.b')}</text>
      <text class="isolation__value isolation__problem" x="294" y="254">{t(lang, 'viz.isolation.wrong')}</text>
    </g>
    <circle data-iso-packet="before" class="isolation__packet--problem" cx="210" cy="237" r="4.5" opacity="0" aria-hidden="true" />
    <path class="isolation__divider" d="M 24 300 H 472" />
    <text class="isolation__outcome isolation__problem" x="24" y="328">{t(lang, 'viz.isolation.before.outcome')}</text>
    <text class="isolation__small" x="24" y="352">{t(lang, 'viz.isolation.before.detail')}</text>
  </g>

  <g transform="translate(526 0)">
    <rect class="isolation__panel" x="1" y="1" width="496" height="372" rx="3" />
    <text class="isolation__eyebrow isolation__solution" x="24" y="29">{t(lang, 'viz.isolation.after')}</text>
    <text class="isolation__title" x="24" y="55">{t(lang, 'viz.isolation.after.title')}</text>

    <path class="isolation__line isolation__line--solution" d="M 218 117 H 274 m -6 -4 l 6 4 l -6 4" />
    <path class="isolation__line isolation__line--solution" d="M 374 151 V 204 m -4 -6 l 4 6 l 4 -6" />
    <path class="isolation__line isolation__line--copy" d="M 120 151 V 204 m -4 -6 l 4 6 l 4 -6" />
    <text class="isolation__small" x="134" y="182">{t(lang, 'viz.isolation.copy')}</text>

    <g>
      <rect class="isolation__box isolation__box--solution" x="24" y="84" width="194" height="67" rx="3" />
      <rect class="isolation__lit" data-iso-lit="after-snapshot" x="24" y="84" width="194" height="67" rx="3" opacity="0" />
      <text class="isolation__label" x="40" y="109">{t(lang, 'viz.isolation.snapshot')}</text>
      <text class="isolation__value" x="40" y="134">{t(lang, 'viz.isolation.original')}</text>
    </g>
    <g>
      <rect class="isolation__box isolation__box--solution" x="274" y="84" width="198" height="67" rx="3" />
      <rect class="isolation__lit" data-iso-lit="after-binding" x="274" y="84" width="198" height="67" rx="3" opacity="0" />
      <text class="isolation__label" x="290" y="109">{t(lang, 'viz.isolation.binding')}</text>
      <text class="isolation__value" x="290" y="134">{t(lang, 'viz.isolation.aad')}</text>
    </g>
    <g>
      <rect class="isolation__box" x="24" y="204" width="194" height="67" rx="3" />
      <text class="isolation__label" x="40" y="229">{t(lang, 'viz.isolation.user.a')}</text>
      <text class="isolation__value" x="40" y="254">{t(lang, 'viz.isolation.private')}</text>
    </g>
    <g>
      <rect class="isolation__box isolation__box--solution" x="274" y="204" width="198" height="67" rx="3" />
      <rect class="isolation__lit" data-iso-lit="after-result" x="274" y="204" width="198" height="67" rx="3" opacity="0" />
      <text class="isolation__label" x="290" y="229">{t(lang, 'viz.isolation.user.b')}</text>
      <text class="isolation__value isolation__solution" x="290" y="254">{t(lang, 'viz.isolation.original')}</text>
    </g>
    <circle data-iso-packet="after-bind" class="isolation__packet" cx="218" cy="117" r="4.5" opacity="0" aria-hidden="true" />
    <circle data-iso-packet="after-result" class="isolation__packet" cx="374" cy="151" r="4.5" opacity="0" aria-hidden="true" />
    <path class="isolation__divider" d="M 24 300 H 472" />
    <text class="isolation__outcome isolation__solution" x="24" y="328">{t(lang, 'viz.isolation.after.outcome')}</text>
    <text class="isolation__small" x="24" y="352">{t(lang, 'viz.isolation.after.detail')}</text>
  </g>
</svg>

<style>
  .isolation { min-width: 54rem; }
  :global(.figure__plate:has(> .isolation)) { overflow-x: auto; }
  .isolation__panel { fill: var(--paper); stroke: var(--rule); }
  .isolation__box { fill: var(--paper-inset); stroke: var(--rule-strong); }
  .isolation__box--problem { stroke: var(--boundary); }
  .isolation__box--solution { stroke: var(--rubric); }
  .isolation__line { fill: none; stroke: var(--ink-muted); stroke-width: 1.3; }
  .isolation__line--problem { stroke: var(--boundary); }
  .isolation__line--solution { stroke: var(--rubric); }
  .isolation__line--copy { stroke-dasharray: 3 4; }
  .isolation__divider { stroke: var(--rule); }
  .isolation .isolation__eyebrow { font-size: 11px; letter-spacing: .1em; }
  .isolation .isolation__title { font-family: var(--family-ui); font-size: 18px; font-weight: 600; fill: var(--ink); }
  .isolation .isolation__label { font-size: 11px; fill: var(--ink-muted); }
  .isolation .isolation__value { font-size: 13px; fill: var(--ink); }
  .isolation .isolation__outcome { font-family: var(--family-ui); font-size: 15px; font-weight: 600; }
  .isolation .isolation__small { font-size: 10px; fill: var(--ink-faint); }
  .isolation .isolation__problem { fill: var(--boundary); }
  .isolation .isolation__solution { fill: var(--rubric); }
  .isolation__lit { fill: var(--rubric); pointer-events: none; }
  .isolation__lit--problem { fill: var(--boundary); }
  .isolation__packet { fill: var(--rubric); }
  .isolation__packet--problem { fill: var(--boundary); }
  @media (prefers-reduced-motion: reduce) {
    [data-iso-packet], [data-iso-lit] { display: none; }
  }
</style>
