---
import type { CollectionEntry } from 'astro:content';
import StatusLabel from './StatusLabel.astro';
import Actions from './Actions.astro';
import Bullets from '../doc/Bullets.astro';
import InlineEmphasis from '../doc/InlineEmphasis.astro';
import DataPanel from '../doc/DataPanel.astro';
import ProductDeck from '../viz/ProductDeck.astro';
import Figure from '../viz/Figure.astro';
import SystemFlow from '../viz/SystemFlow.astro';
import PublisherComparison from '../viz/PublisherComparison.astro';
import ResultIsolation from '../viz/ResultIsolation.astro';
import { t, localise, type Lang } from '../../i18n/ui';
import { slugOf } from '../../lib/content';

/**
 * A product on the overview page.
 *
 * Pipeline context, product and role, then one concrete defect and its result.
 */
interface Props {
  entry: CollectionEntry<'projects'>;
  n: string;
  caseN: string;
  lang: Lang;
}
const { entry, n, caseN, lang } = Astro.props;
const p = entry.data;
const slug = slugOf(entry);
const href = localise(lang, `/work/${slugOf(entry)}/`);

/* The one filled button points at the write-up, not at an address whose
   servers are off. */
const actions = [
  { href, label: t(lang, 'work.built'), kind: 'deployed' as const },
  ...p.links.map((l) => ({
    href: l.href,
    label: l.label,
    kind: p.hosting === 'offline' && l.kind === 'deployed' ? ('doc' as const) : l.kind,
  })),
];
---

<div class="project">
  <div class="column column--wide project__head">
    <p class="meta project__meta">
      <span>{p.period}</span>
      <span class="project__sep">·</span>
      <span>{p.team}</span>
      <StatusLabel status={p.status} hosting={p.hosting} lang={lang} />
    </p>
    <h3 class="project__title"><a href={href}>{p.title}</a></h3>
    <p class="project__tagline">{p.tagline}</p>
  </div>

  {
    p.pipeline && (
      <div class="column column--wide project__flow">
        <Figure n={n} title={[t(lang, 'fig.pipeline', { title: p.title }), p.pipeline.note].filter(Boolean).join(' ')} lang={lang}>
          <SystemFlow
            from={p.pipeline.from}
            to={p.pipeline.to}
            feeds={p.pipeline.feeds}
            stages={p.pipeline.stages}
            lang={lang}
          />
        </Figure>
      </div>
    )
  }

  <div class="column column--wide project__body">
    <div class="project__side">
      <ProductDeck slug={slugOf(entry)} lang={lang} />
    </div>

    <div class="project__lead">
      <Bullets items={p.summary} />
      <Actions actions={actions} />
      <div class="project__panel">
        <DataPanel items={p.data} />
      </div>
    </div>
  </div>
  {(slug === 'dartoo' || slug === 'map') && (
    <div class="column column--wide project__case">
      <h4>{t(lang, slug === 'dartoo' ? 'case.dartoo' : 'case.map')}</h4>
      <p><InlineEmphasis text={t(lang, slug === 'dartoo' ? 'case.dartoo.lede' : 'case.map.lede')} /></p>
      <Figure n={caseN} title={t(lang, slug === 'dartoo' ? 'fig.reconciliation' : 'fig.isolation')} lang={lang}>
        {slug === 'dartoo' ? <PublisherComparison lang={lang} /> : <ResultIsolation lang={lang} />}
      </Figure>
    </div>
  )}
</div>

<style>
  .project + .project {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .project__sep {
    color: var(--rule-strong);
  }
  .project__title {
    font-size: 1.4375rem;
    line-height: 1.2;
    letter-spacing: -0.022em;
  }
  .project__title a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  .project__title a:hover {
    color: var(--rubric);
    border-bottom-color: currentColor;
  }
  .project__tagline {
    margin-top: 0.4rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    max-width: 78ch;
    text-wrap: pretty;
  }
  .project__flow {
    margin-top: 0.9rem;
  }

  .project__body {
    margin-top: 1.1rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 52rem) {
    .project__body {
      grid-template-columns: 20.5rem minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }
  .project__side {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .project__panel {
    margin-top: 1.1rem;
  }
  .project__case { margin-top: 2rem; }
  .project__case h4 { font-size: 1.125rem; font-weight: 600; }
  .project__case > p { max-width: 80ch; margin-top: .5rem; font-size: .9375rem; color: var(--ink-muted); line-height: 1.7; }
  .project__case > p :global(strong) { color: var(--ink); font-weight: 600; }
</style>
