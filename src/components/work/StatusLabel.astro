---
/** Deployed is drawn in neutral ink. Green would read as "uptime is fine", and
 *  nothing here is operated. Amber is reserved for things still open.
 *
 *  `hosting` is a separate fact from `status`. A service can have been
 *  deployed and demonstrated and have its servers powered down now; saying
 *  only "deployed" would let a reader assume they can open it. */
import { t, type Lang } from '../../i18n/ui';

interface Props {
  status: 'deployed' | 'in-progress' | 'archived' | 'on-hold';
  hosting?: 'offline' | 'reachable' | 'none';
  lang?: Lang;
}
const { status, hosting = 'none', lang = 'en' } = Astro.props;
---

<span class="status-set">
  <span class:list={['status', `status--${status}`]}>{t(lang, `status.${status}`)}</span>
  {hosting === 'offline' && <span class="status status--offline">{t(lang, 'status.offline')}</span>}
</span>

<style>
  .status-set {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .status {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    padding: 0.15em 0.5em;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .status--in-progress,
  .status--on-hold {
    color: var(--boundary);
    border-color: currentColor;
  }
  /* Powered down is a fact about now, drawn as a struck-through rule rather
     than a colour, so it does not compete with the limit colour. */
  .status--offline {
    color: var(--ink-faint);
    border-style: dashed;
  }
</style>
