---
import Work from '../../components/pages/Work.astro';
import { projectsOf, slugOf } from '../../lib/content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await projectsOf('en');
  return projects.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<Work entry={entry} lang="en" />
