---
// PHASE 1 — typographic skeleton. No colour, no motion. Real copy, not lorem:
// the measure is only worth judging against the sentences it has to carry.
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Controls from '../components/chrome/Controls.astro';
import NoteLines from '../components/note/NoteLines.astro';

const entry = await getEntry('projects', 'dartoo');
if (!entry) throw new Error('missing dartoo entry');
const { Content } = await render(entry);
const p = entry.data;
---

<Base title="Ryu Jemu — backend, verified in the margin">
  <div class="shell page-top">
    <Controls />
  </div>

  <main class="shell">
    <article class="document" data-annotated>
      <NoteLines />

      <header class="column entry-head">
        <p class="meta">§ 3.1 &nbsp;·&nbsp; {p.period} &nbsp;·&nbsp; {p.team}</p>
        <h1>{p.title}</h1>
        <p class="lede">{p.tagline}</p>
        <p class="meta entry-head__role">{p.role}</p>
      </header>

      <div class="column prose">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  .page-top {
    padding-block: 1.75rem 0;
  }

  main {
    padding-block: 3rem 8rem;
  }

  .entry-head {
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .entry-head h1 {
    margin-top: 0.6rem;
  }

  .lede {
    margin-top: 0.9rem;
    font-size: var(--t-lede);
    line-height: var(--lh-lede);
    font-weight: 300;
    font-style: italic;
    color: var(--ink-muted);
  }

  .entry-head__role {
    margin-top: 1.1rem;
  }
</style>
