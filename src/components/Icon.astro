---
type IconName = 'user' | 'code' | 'mail' | 'arrow-up-right' | 'arrow-down' | 'layers' | 'brain' | 'database' | 'smartphone' | 'compass' | 'route' | 'book' | 'award' | 'chart' | 'search' | 'tool' | 'graduation' | 'target' | 'check' | 'alert' | 'lightbulb' | 'link' | 'grid' | 'cloud' | 'activity' | 'server' | 'flask';
interface Props { name: IconName; size?: number; class?: string; tone?: 'inherit' }
const { name, size = 20, class: className, tone } = Astro.props;
const tones: Partial<Record<IconName, 'blue' | 'teal' | 'violet' | 'amber'>> = {
  code: 'blue', layers: 'blue', route: 'blue', smartphone: 'blue', cloud: 'blue', server: 'blue',
  database: 'teal', chart: 'teal', check: 'teal', compass: 'teal', search: 'teal', activity: 'teal',
  brain: 'violet', book: 'violet', graduation: 'violet', flask: 'violet',
  award: 'amber', lightbulb: 'amber', tool: 'amber', target: 'amber', alert: 'amber',
};
const iconTone = tones[name];
const colorStyle = tone === 'inherit' || !iconTone
  ? 'color:inherit'
  : `--icon-tone:var(--icon-${iconTone});color:var(--icon-tone)`;
const paths: Record<IconName, string[]> = {
  user: ['M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z', 'M4 21v-2a8 8 0 0 1 16 0v2'],
  code: ['m8 7-5 5 5 5', 'm16 7 5 5-5 5', 'm14 4-4 16'],
  mail: ['M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z', 'm3 6 9 7 9-7'],
  'arrow-up-right': ['M6 18 18 6', 'M6 6h12v12'],
  'arrow-down': ['M12 4v16', 'm5 13 7 7 7-7'],
  layers: ['m12 3 10 6-10 6L2 9l10-6Z', 'm3 13 9 5 9-5', 'm3 17 9 5 9-5'],
  brain: ['M12 6a3 3 0 0 0-6-1 4 4 0 0 0-3 6 4 4 0 0 0 2 7 3.5 3.5 0 0 0 7 1V6Z', 'M12 6a3 3 0 0 1 6-1 4 4 0 0 1 3 6 4 4 0 0 1-2 7 3.5 3.5 0 0 1-7 1', 'M6 5v3M3 11h3l2 2M5 18l3-2M18 5v3m3 3h-3l-2 2m3 5-3-2'],
  database: ['M20 6c0 2-3.6 3-8 3S4 8 4 6s3.6-3 8-3 8 1 8 3Z', 'M4 6v12c0 2 3.6 3 8 3s8-1 8-3V6', 'M4 12c0 2 3.6 3 8 3s8-1 8-3'],
  smartphone: ['M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z', 'M10 5h4M11 19h2'],
  compass: ['M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', 'm16 8-3 5-5 3 3-5 5-3Z'],
  route: ['M7 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z', 'M21 19a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z', 'M7 5h9a4 4 0 0 1 0 8H8a3 3 0 0 0 0 6h9'],
  book: ['M12 5v16', 'M12 5C9 3 6 3 3 4v15c3-1 6-1 9 2 3-3 6-3 9-2V4c-3-1-6-1-9 1Z'],
  award: ['M18 8a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z', 'm7 12-2 10 7-4 7 4-2-10'],
  chart: ['M3 3v18h18', 'M7 16v-5m5 5V6m5 10V9'],
  search: ['M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z', 'm16 16 6 6'],
  tool: ['M14 3a7 7 0 0 0-8 8l-3 7a2.8 2.8 0 0 0 3.8 3.8l7-7a7 7 0 0 0 7-9l-4 4-3-3 3-4-2.8.2Z'],
  graduation: ['m12 3 11 6-11 6L1 9l11-6Z', 'M5 12v6c4 3 10 3 14 0v-6M23 9v8'],
  target: ['M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', 'M18 12a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z', 'M14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z'],
  check: ['M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', 'm7 12 3 3 7-7'],
  alert: ['M10.2 3.6a2 2 0 0 1 3.6 0l8 15A1.7 1.7 0 0 1 20.3 21H3.7a1.7 1.7 0 0 1-1.5-2.4l8-15Z', 'M12 9v5m0 3v.2'],
  lightbulb: ['M9 17c0-3-4-4-4-8a7 7 0 0 1 14 0c0 4-4 5-4 8H9Z', 'M9 20h6m-5 3h4'],
  link: ['m10 13 4-4', 'M8 15H6a4 4 0 0 1-3-7l4-4a4 4 0 0 1 7 3v1', 'M16 9h2a4 4 0 0 1 3 7l-4 4a4 4 0 0 1-7-3v-1'],
  grid: ['M3 3h7v7H3V3Zm11 0h7v7h-7V3ZM3 14h7v7H3v-7Zm11 0h7v7h-7v-7Z'],
  cloud: ['M7 19h11a4 4 0 0 0 .6-8 7 7 0 0 0-13.4-2A5 5 0 0 0 7 19Z'],
  activity: ['M2 12h5l3-8 4 16 3-8h5'],
  server: ['M5 3h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z', 'M5 13h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2Z', 'M7 7h.01M11 7h6M7 17h.01M11 17h6'],
