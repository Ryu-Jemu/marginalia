---
import type { CollectionEntry } from 'astro:content';
import StatusLabel from './StatusLabel.astro';

/**
 * The smaller work, as a table rather than a stack of cards.
 *
 * These entries earn a line each: what it is, what it was for, and where to
 * read the rest. Giving them the same vertical weight as the main projects
 * would say something about them that is not true.
 */
interface Props {
  entries: CollectionEntry<'projects'>[];
}
const { entries } = Astro.props;
---

<ul class="compact">
  {
    entries.map((entry) => {
      const p = entry.data;
      const href = `/work/${entry.id.replace(/^tier2\//, '')}/`;
      return (
        <li class="compact__row">
          <span class="compact__period">{p.period}</span>
          <span class="compact__body">
            <a class="compact__title" href={href}>
              {p.title}
            </a>
            <span class="compact__tagline">{p.tagline}</span>
            <span class="compact__stack">{p.stack.slice(0, 4).join(' · ')}</span>
          </span>
          <span class="compact__status">
            <StatusLabel status={p.status} />
          </span>
        </li>
      );
    })
  }
</ul>

<style>
  .compact {
    display: grid;
  }
  .compact__row {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 0.2rem 0.85rem;
    align-items: baseline;
    padding-block: 0.65rem;
    border-top: 1px solid var(--rule);
  }
  .compact__row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (max-width: 34rem) {
    .compact__row {
      grid-template-columns: 1fr auto;
    }
    .compact__period {
      grid-column: 1 / -1;
    }
  }
  .compact__period {
    font-family: var(--family-mono);
    font-size: var(--t-data);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .compact__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .compact__title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    text-decoration: none;
    width: fit-content;
    border-bottom: 1px solid var(--rule-strong);
  }
  .compact__title:hover {
    color: var(--rubric);
    border-bottom-color: currentColor;
  }
  .compact__tagline {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .compact__stack {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    color: var(--ink-faint);
    margin-top: 0.1rem;
  }
  .compact__status {
    justify-self: end;
  }
</style>
