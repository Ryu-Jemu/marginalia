---
import Paper from '../../components/pages/Paper.astro';
import {researchOf} from '../../lib/content';
export const prerender=true;
export async function getStaticPaths(){
  return (await researchOf()).map(paper=>({params:{id:paper.id},props:{paper}}));
}
const {paper}=Astro.props;
---
<Paper paper={paper}/>
