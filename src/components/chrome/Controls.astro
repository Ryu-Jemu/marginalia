---
import { t, type Lang } from '../../i18n/ui';

/**
 * Reading controls, styled like the settings strip on a proof sheet rather
 * than app chrome. Rendered server-side with the default state; the inline
 * head script has already corrected <html> before this paints, and
 * controls.ts relabels the buttons on load.
 *
 * Each button carries its own labels, because the script that swaps them runs
 * on both language trees and has no other way to know which one it is in.
 *
 * Hidden entirely without JavaScript — a control that cannot work should not
 * advertise itself.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const labels = {
  theme: { light: t(lang, 'controls.theme.light'), dark: t(lang, 'controls.theme.dark') },
  notes: { margin: t(lang, 'controls.notes.margin'), inline: t(lang, 'controls.notes.inline') },
  motion: { on: t(lang, 'controls.motion.on'), off: t(lang, 'controls.motion.off') },
} as const;
---

<div class="controls" role="group" aria-label={t(lang, 'controls.group')}>
  <button type="button" data-control="theme" data-labels={JSON.stringify(labels.theme)} class="controls__btn">
    <span data-control-value>{labels.theme.light}</span>
  </button>
  <button type="button" data-control="notes" data-labels={JSON.stringify(labels.notes)} class="controls__btn">
    <span data-control-value>{labels.notes.margin}</span>
  </button>
  <button type="button" data-control="motion" data-labels={JSON.stringify(labels.motion)} class="controls__btn">
    <span data-control-value>{labels.motion.on}</span>
  </button>
</div>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  :global(.no-js) .controls {
    display: none;
  }

  .controls__btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.15rem 0;
    font-family: var(--family-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-faint);
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  .controls__btn:hover {
    color: var(--rubric);
    border-bottom-color: var(--rubric);
  }

  @media (prefers-reduced-motion: reduce) {
    .controls__btn {
      transition: none;
    }
  }
</style>
