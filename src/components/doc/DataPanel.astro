---
/**
 * The figures a piece of work is measured in, before any prose.
 *
 * Each value counts up from zero when it comes into view. That is not
 * decoration: the panel exists so the size of the thing is legible in a glance,
 * and a number that arrives by moving is read rather than skimmed past. With
 * motion off it is simply printed.
 */
interface Item {
  value: string;
  label: string;
  detail?: string;
}
interface Props {
  items: Item[];
  /** Compact drops the detail line — used where space is tight. */
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
---

<dl class:list={['panel', compact && 'panel--compact']} data-panel>
  {
    items.map((it) => (
      <div class="panel__cell">
        <dt class="panel__value" data-countup>
          {it.value}
        </dt>
        <dd class="panel__label">{it.label}</dd>
        {!compact && it.detail && <dd class="panel__detail">{it.detail}</dd>}
      </div>
    ))
  }
</dl>

<style>
  .panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.25rem, 1fr));
    gap: 0.9rem 1.5rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .panel__cell {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .panel__value {
    font-size: 1.4375rem;
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .panel--compact .panel__value {
    font-size: 1.1875rem;
  }
  .panel__label {
    margin: 0.25rem 0 0;
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .panel__detail {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-faint);
    text-wrap: pretty;
  }
</style>
