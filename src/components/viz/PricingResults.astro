---
import StudyFigure from './StudyFigure.astro';
import { pricingResults as results } from '../../data/pricing-results';

interface Props { id?: string }
const { id = 'pricing-policy-results' } = Astro.props;
const plotX = 116;
const plotWidth = 540;
const x = (value: number) => plotX + value / results.axisMaximum * plotWidth;
const y = (index: number) => 64 + index * 73;
const integer = new Intl.NumberFormat('ko-KR', { maximumFractionDigits: 0 });
const decimal = new Intl.NumberFormat('ko-KR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---
<StudyFigure id={id} title={results.title} description={results.description} caption={results.caption} eyebrow="정책 비교">
  <div slot="chart" class="pricing-chart">
    <p class="pricing-legend"><span class="legend-bar" aria-hidden="true"></span>막대: 평균<span class="legend-whisker" aria-hidden="true"></span>오차선: 학습 시드 간 표준편차</p>
    <svg viewBox="0 0 760 390" width="760" height="390" role="img" aria-labelledby={`${id}-svg-title ${id}-svg-description`}>
      <title id={`${id}-svg-title`}>{results.title}</title>
      <desc id={`${id}-svg-description`}>가로축은 0에서 시작하는 누적 순보상. {results.policies.map(policy => `${policy.label} ${integer.format(policy.mean)}`).join(', ')}. 강화학습 정책의 오차선은 학습 시드 평균 간 표준편차. 세부 수치는 아래 표 제공.</desc>
      <g class="pricing-grid">
        {results.ticks.map(tick => <line x1={x(tick)} y1="29" x2={x(tick)} y2="326"/>)}
      </g>
      <line class="pricing-origin" x1={plotX} y1="29" x2={plotX} y2="326"/>
      {results.policies.map((policy, index) => (
        <g>
          <text class="policy-label" x="0" y={y(index) + 6}>{policy.label}</text>
          <rect x={plotX} y={y(index) - 17} width={x(policy.mean) - plotX} height="34" fill={policy.color} opacity=".82"/>
          {policy.seedStd !== null && <g class="policy-whisker">
            <line x1={x(policy.mean - policy.seedStd)} y1={y(index)} x2={x(policy.mean + policy.seedStd)} y2={y(index)}/>
            <line x1={x(policy.mean - policy.seedStd)} y1={y(index) - 7} x2={x(policy.mean - policy.seedStd)} y2={y(index) + 7}/>
            <line x1={x(policy.mean + policy.seedStd)} y1={y(index) - 7} x2={x(policy.mean + policy.seedStd)} y2={y(index) + 7}/>
          </g>}
          <text class="policy-value" x={x(policy.mean + (policy.seedStd ?? 0)) + 12} y={y(index) + 6}>{integer.format(policy.mean)}</text>
        </g>
      ))}
      <line class="pricing-axis" x1={plotX} y1="326" x2={x(results.axisMaximum)} y2="326"/>
      {results.ticks.map(tick => <text class="tick-label" x={x(tick)} y="350" text-anchor="middle">{integer.format(tick)}</text>)}
      <text class="axis-label" x={plotX + plotWidth / 2} y="382" text-anchor="middle">{results.unit}</text>
    </svg>
    <p class="pricing-finding">{results.finding}</p>
  </div>
  <div slot="table" class="pricing-values">
    <table>
      <caption>m = 1의 정책별 누적 순보상 · 소수 둘째 자리 표시</caption>
      <thead><tr><th scope="col">정책</th><th scope="col">평균</th><th scope="col">시드 간 표준편차</th>{results.trainingSeeds.map(seed => <th scope="col">시드 {seed}</th>)}</tr></thead>
      <tbody>{results.policies.map(policy => <tr>
        <th scope="row">{policy.label}</th>
        <td>{decimal.format(policy.mean)}</td>
        <td>{policy.seedStd === null ? '해당 없음' : decimal.format(policy.seedStd)}</td>
        {results.trainingSeeds.map((_, index) => <td>{policy.seedMeans[index] === undefined ? '—' : decimal.format(policy.seedMeans[index])}</td>)}
      </tr>)}</tbody>
    </table>
    <ul class="pricing-reading">
      <li>{results.formula}</li>
      <li>시드별 값은 해당 학습 정책의 평가 에피소드 평균. 오차선은 세 평균의 모집단 표준편차이며 신뢰구간이 아님.</li>
      <li>Max-Price는 학습 없는 고정 정책. 평가 에피소드 간 편차를 학습 시드 간 편차와 섞지 않도록 오차선 생략.</li>
      <li>시뮬레이션 조건 안의 비교. 실제 통신망 매출이나 전체 이탈 조건의 정책 우위로 일반화하지 않음.</li>
    </ul>
  </div>
</StudyFigure>

<style>
  .pricing-chart{min-width:0;width:100%;max-width:940px}
  .pricing-legend{display:flex;align-items:center;gap:9px;margin:0 0 9px;padding-left:2px;color:var(--muted);font-size:14px;line-height:1.6}
  .legend-bar{width:19px;height:11px;background:var(--blue);opacity:.82;flex:none}
  .legend-whisker{position:relative;width:21px;height:10px;margin-left:14px;border-inline:1.5px solid var(--ink);flex:none}
  .legend-whisker::after{position:absolute;top:4px;left:0;right:0;content:'';border-top:1.5px solid var(--ink)}
  .pricing-finding{max-width:70ch;margin:12px 0 0;color:var(--ink);font-size:15px;line-height:1.75;word-break:keep-all;overflow-wrap:anywhere}
  svg{display:block;width:100%;height:auto;min-width:680px;font-family:var(--font);font-variant-numeric:tabular-nums}
  .pricing-grid line{stroke:var(--line);stroke-width:1;stroke-dasharray:3 5}
  .pricing-origin,.pricing-axis{stroke:var(--line-strong);stroke-width:1.2}
  .policy-label,.policy-value{fill:var(--ink);font-size:18px;font-weight:600}
  .policy-whisker{stroke:var(--ink);stroke-width:1.8}
  .tick-label,.axis-label{fill:var(--muted);font-size:16px}
  .pricing-values table{min-width:650px}
  .pricing-values th,.pricing-values td{white-space:nowrap}
  .pricing-reading{max-width:76ch;padding-left:18px}
  .pricing-reading li+li{margin-top:7px}
  @media print{.pricing-chart,svg{min-width:0;max-width:100%}.pricing-values table{min-width:0}}
</style>
