---
import { t, type Lang } from '../../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const runs = [
  { key: 'before', persisted: 959, published: 805, missing: 154 },
  { key: 'after', persisted: 3948, published: 3948, missing: 0 },
] as const;
---

<div class="reconciliation">
  {runs.map((run) => (
    <section class="reconciliation__run">
      <h4>{t(lang, `reconcile.${run.key}`)}</h4>
      <p class="reconciliation__condition">{t(lang, `reconcile.${run.key}.condition`)}</p>
      <table>
        <tbody>
          <tr>
            <th scope="row">{t(lang, 'reconcile.persisted')}</th>
            <td class="reconciliation__bar" aria-hidden="true"><span style="--w:100%" /></td>
            <td class="reconciliation__number">{run.persisted.toLocaleString('en-US')}</td>
          </tr>
          <tr>
            <th scope="row">{t(lang, 'reconcile.published')}</th>
            <td class="reconciliation__bar" aria-hidden="true"><span class="reconciliation__published" style={`--w:${run.published / run.persisted * 100}%`} /></td>
            <td class="reconciliation__number">{run.published.toLocaleString('en-US')}</td>
          </tr>
        </tbody>
      </table>
      <p class:list={['reconciliation__difference', run.missing > 0 && 'reconciliation__difference--missing']}>
        <strong>{run.missing}</strong> {t(lang, 'reconcile.missing')}
      </p>
    </section>
  ))}
</div>

<style>
  .reconciliation { display: grid; gap: 1.5rem 2.5rem; }
  @media (min-width: 48rem) { .reconciliation { grid-template-columns: 1fr 1fr; } }
  h4 { font-size: 1.125rem; font-weight: 600; }
  .reconciliation__condition { margin-top: .4rem; min-height: 3em; font-size: .8125rem; color: var(--ink-muted); line-height: 1.5; }
  table { width: 100%; border-collapse: separate; border-spacing: 0 .65rem; margin-top: .5rem; }
  th { width: 4.25rem; padding-right: .7rem; text-align: left; font-size: .8125rem; font-weight: 400; }
  .reconciliation__number { width: 4rem; text-align: right; font-family: var(--family-mono); font-size: .9375rem; font-variant-numeric: tabular-nums; }
  .reconciliation__bar { vertical-align: middle; }
  .reconciliation__bar span { display: block; width: var(--w); height: .625rem; background: var(--ink-muted); }
  .reconciliation__bar .reconciliation__published { background: var(--rubric); }
  .reconciliation__difference { padding-top: .4rem; font-size: .8125rem; color: var(--rubric); }
  .reconciliation__difference strong { margin-right: .2em; font-family: var(--family-mono); font-size: 1.625rem; font-weight: 500; }
  .reconciliation__difference--missing { color: var(--boundary); }
</style>
