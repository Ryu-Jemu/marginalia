---
import type {Project} from '../lib/content';
import Icon from './Icon.astro';
import DisclosureIndicator from './DisclosureIndicator.astro';
interface Props{cases:Project['data']['cases']}
const {cases}=Astro.props;
---
<div class="star-list">{cases.map((c,i)=><details class="star-case" id={c.id} open={i===0}>
 <summary class="case-header" data-disclosure-summary><h3>{c.title}</h3><DisclosureIndicator/></summary>
 <div class="case-content">
 <div class="star-grid">
  <section class="star-block"><h4><Icon name="alert" size={18}/> 상황 <span aria-hidden="true">S</span></h4><p>{c.situation}</p></section>
  <section class="star-block"><h4><Icon name="target" size={18}/> 목표 <span aria-hidden="true">T</span></h4><p>{c.task}</p></section>
  <section class="star-block action"><h4><Icon name="tool" size={18}/> 조치 <span aria-hidden="true">A</span></h4><p class="cause"><strong>원인</strong> {c.cause}</p><ul>{c.actions.map(x=><li>{x}</li>)}</ul></section>
  <section class="star-block result"><h4><Icon name="check" size={18}/> 결과 <span aria-hidden="true">R</span></h4><ul>{c.results.map(x=><li>{x}</li>)}</ul></section>
 </div>
 <figure class="case-comparison" aria-label={`${c.title} 개선 전후 흐름`}>
  <div class="comparison-row"><span class="comparison-label">개선 전</span><ol>{c.before.map(x=><li>{x}</li>)}</ol></div>
  <div class="comparison-row after"><span class="comparison-label">개선 후</span><ol>{c.after.map(x=><li>{x}</li>)}</ol></div>
 </figure>
 {(c.ai||c.decision||c.reflection)&&<dl class="ai-attribution">{c.ai&&<div><dt>AI 활용</dt><dd>{c.ai}</dd></div>}{c.decision&&<div><dt>설계 판단</dt><dd>{c.decision}</dd></div>}{c.reflection&&<div><dt>회고</dt><dd>{c.reflection}</dd></div>}</dl>}
 </div>
</details>)}</div>
<style>
 .star-case>summary{list-style:none;cursor:pointer;align-items:center;justify-content:space-between;gap:20px!important;min-height:64px;margin-bottom:0!important}
 .star-case>summary::-webkit-details-marker{display:none}
 .case-content{padding-top:20px}
 @media print{.star-case::details-content{content-visibility:visible!important;display:block!important}}
</style>
