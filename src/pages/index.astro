---
// PHASE 0 SMOKE TEST — verifies that Sätteri renders MDX content-collection
// entries that call an .astro component. Replaced in Phase 1.
import { getEntry, render } from 'astro:content';

const entry = await getEntry('projects', 'dartoo');
if (!entry) throw new Error('missing dartoo entry');
const { Content } = await render(entry);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phase 0 — note component smoke test</title>
  </head>
  <body>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.tagline}</p>
    <article>
      <Content />
    </article>
  </body>
</html>
