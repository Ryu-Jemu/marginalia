---
import Figure from './Figure.astro';
import SilentLoss from './SilentLoss.astro';
import RaceTimeline from './RaceTimeline.astro';
import RouteStages from './RouteStages.astro';
import PricingChart from './PricingChart.astro';
import CrimeHeatmap from './CrimeHeatmap.astro';
import CrimeModel from './CrimeModel.astro';
import CrimeFit from './CrimeFit.astro';
import CinemaTrend from './CinemaTrend.astro';
import CinemaCorrelation from './CinemaCorrelation.astro';
import CinemaWords from './CinemaWords.astro';
import { t, type Lang } from '../../i18n/ui';

/**
 * Which plates belong to which project. Kept out of the content files so the
 * MDX stays prose, and out of the schema so a figure is a rendering decision
 * rather than a data one.
 *
 * `startAt` continues the page's figure numbering past whatever came before,
 * so a page with a pipeline plate above does not restart at one.
 */
interface Props {
  slug: string;
  startAt?: number;
  lang?: Lang;
}
const { slug, startAt = 0, lang = 'en' } = Astro.props;
let n = startAt;
const next = () => String(++n);
---

{
  slug === 'dartoo' && (
    <Figure n={next()} title={t(lang, 'fig.silentloss')} lang={lang}>
      <SilentLoss lang={lang} />
    </Figure>
  )
}

{
  slug === 'map' && (
    <>
      <Figure n={next()} title={t(lang, 'fig.race')} lang={lang}>
        <RaceTimeline lang={lang} />
      </Figure>
      <Figure n={next()} title={t(lang, 'fig.routestages')} lang={lang}>
        <RouteStages lang={lang} />
      </Figure>
    </>
  )
}

{
  slug === 'network-pricing' && (
    <Figure n={next()} title={t(lang, 'fig.pricing')} lang={lang}>
      <PricingChart lang={lang} />
    </Figure>
  )
}

{
  slug === 'cinema-dashboard' && (
    <>
      <Figure n={next()} title={t(lang, 'fig.cinema.trend')} lang={lang}>
        <CinemaTrend lang={lang} />
      </Figure>
      <Figure n={next()} title={t(lang, 'fig.cinema.corr')} lang={lang}>
        <CinemaCorrelation lang={lang} />
      </Figure>
      <Figure n={next()} title={t(lang, 'fig.cinema.words')} lang={lang}>
        <CinemaWords lang={lang} />
      </Figure>
    </>
  )
}

{
  slug === 'crime-analysis' && (
    <>
      {/* Before the fit, because that is when it was drawn and what it was
          drawn for: nothing here is read until collinearity has been. */}
      <Figure n={next()} title={t(lang, 'fig.crime.heatmap')} lang={lang}>
        <CrimeHeatmap lang={lang} />
      </Figure>
      <Figure n={next()} title={t(lang, 'fig.crime.model')} lang={lang}>
        <CrimeModel lang={lang} />
      </Figure>
      <Figure n={next()} title={t(lang, 'fig.crime.fit')} lang={lang}>
        <CrimeFit lang={lang} />
      </Figure>
    </>
  )
}
