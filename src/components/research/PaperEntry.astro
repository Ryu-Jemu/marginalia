---
import type { CollectionEntry } from 'astro:content';
import Bullets from '../doc/Bullets.astro';
import Actions from '../work/Actions.astro';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const r = entry.data;

/**
 * Rendered from {index, of}. The position cannot be mistyped into a stronger
 * claim, because it is never written as prose anywhere in the content.
 */
const ORDINAL = ['', 'first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh'];
const authorship =
  r.authorPosition.of === 1
    ? 'Sole author'
    : r.authorPosition.index === 1
      ? `First author of ${r.authorPosition.of}`
      : `Co-author — ${ORDINAL[r.authorPosition.index] ?? r.authorPosition.index} of ${r.authorPosition.of}`;

const STATUS = {
  accepted: 'Accepted',
  'under-review': 'Under review',
  revision: 'In revision',
  assisting: 'Lab work',
} as const;

/** Two lines of what I did — the rest is on the paper's own page. */
const role = r.role.slice(0, 2);
---

<article class="paper">
  <p class="meta paper__meta">
    <span class="paper__authorship">{authorship}</span>
    <span class="paper__sep">·</span>
    <span class="paper__status" data-status={r.status}>{STATUS[r.status]}</span>
    <span class="paper__sep">·</span>
    <span>{r.date}</span>
  </p>

  <h3 class="paper__title"><a href={`/research/${entry.id}/`}>{r.title}</a></h3>
  <p class="paper__venue">{r.venue}</p>

  {
    r.contribution && (
      <p class="paper__contribution">
        <span class="paper__contribution-key">My part</span>
        {r.contribution}
      </p>
    )
  }

  {role.length > 0 && <div class="paper__role"><Bullets items={role} /></div>}

  {
    (r.manuscriptId || r.grant || r.award) && (
      <p class="paper__ids">
        {r.award && <span class="paper__award">{r.award}</span>}
        {r.manuscriptId && <span>{r.manuscriptId}</span>}
        {r.grant && <span>{r.grant}</span>}
      </p>
    )
  }

  <Actions
    actions={[{ href: `/research/${entry.id}/`, label: 'Read the paper', kind: 'detail' }]}
  />
</article>

<style>
  .paper {
    padding-block: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .paper:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .paper__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }
  .paper__authorship {
    color: var(--rubric);
  }
  .paper__sep {
    color: var(--rule-strong);
  }
  /* Anything not yet peer reviewed is marked as such, at the top. */
  .paper__status[data-status='under-review'],
  .paper__status[data-status='revision'] {
    color: var(--boundary);
  }
  .paper__title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.016em;
    font-weight: 600;
  }
  .paper__title a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  .paper__title a:hover {
    color: var(--rubric);
    border-bottom-color: currentColor;
  }
  .paper__venue {
    margin-top: 0.25rem;
    color: var(--ink-muted);
    font-style: italic;
  }
  /* On a seven-author paper the useful line is which part is his. */
  .paper__contribution {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--family-mono);
    font-size: var(--t-data);
    color: var(--ink);
  }
  .paper__contribution-key {
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--rubric);
  }
  .paper__role {
    margin-top: 0.6rem;
  }
  .paper__ids {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.6rem;
    font-family: var(--family-mono);
    font-size: var(--t-data);
    color: var(--ink-faint);
  }
  .paper__award {
    color: var(--rubric);
  }
</style>
