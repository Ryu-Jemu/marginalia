---
import Paper from '../../components/pages/Paper.astro';
import { researchOf } from '../../lib/content';

export const prerender = true;

export async function getStaticPaths() {
  const research = await researchOf('en');
  return research.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const build = entry.data.implementation;
---

<Paper entry={entry} lang="en" buildHref={build ? `/work/${build.project}/` : undefined} />
