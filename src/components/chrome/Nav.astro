---
import { nav } from '../../lib/site';
import Icon from '../Icon.astro';
---
<header class="site-header">
  <div class="wrap nav-row">
    <a class="brand" href="/" aria-label="류제무 포트폴리오 홈">류제무<span class="brand-dot" aria-hidden="true"></span></a>
    <nav aria-label="주요 메뉴" data-section-nav>{nav.map(n => <a href={`/#${n.id}`}><Icon name={n.id === 'about' ? 'user' : n.id === 'research' ? 'book' : 'layers'} size={17}/>{n.label}</a>)}</nav>
    <button class="motion-toggle" data-motion-toggle aria-pressed="false" aria-label="모션 끄기" hidden><span aria-hidden="true">◉</span> <span data-motion-label>모션 켜짐</span></button>
  </div>
</header>
<style>
  .site-header{position:sticky;top:0;z-index:30;background:rgba(255,255,255,.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--line-strong)}
  .nav-row{max-width:1120px;height:72px;display:flex;align-items:center;gap:28px}
  .brand{font-size:18px;font-weight:700;display:flex;align-items:center;gap:6px;white-space:nowrap}
  .brand-dot{width:7px;height:7px;background:var(--blue)}
  nav{display:flex;gap:28px;margin-left:auto}
  nav a{position:relative;font-size:14px;min-height:44px;display:flex;align-items:center;gap:7px;font-weight:550;white-space:nowrap}
  nav a::after{position:absolute;content:'';height:3px;inset:auto 0 0;background:var(--blue);transform:scaleX(0);transform-origin:left;transition:transform .18s}
  nav a:hover::after,nav a[aria-current=location]::after{transform:scaleX(1)}
  nav a[aria-current=location]{color:var(--blue)}
  .motion-toggle{font-size:14px;padding:7px 0 7px 10px;white-space:nowrap;border:0;color:var(--muted)}
  @media(max-width:600px){.nav-row{height:64px;gap:10px}.brand{font-size:17px}nav{gap:10px}.motion-toggle{font-size:14px;padding:4px}.motion-toggle>span:first-child{display:none}nav a{font-size:14px;gap:4px}nav a :global(svg){width:15px;height:15px}}
  @media(max-width:360px){.nav-row{gap:8px}nav{gap:12px}nav a :global(svg){display:none}}
</style>
