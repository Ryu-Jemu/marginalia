---
import InlineEmphasis from '../doc/InlineEmphasis.astro';
import { t, type Lang } from '../../i18n/ui';
interface Props {
  items: { area: string; work: string; context: string }[];
  lang: Lang;
}
const { items, lang } = Astro.props;
---

<div class="contribution-table" tabindex="0" role="region" aria-label={t(lang, 'work.scope')}>
  <table>
    <thead>
      <tr><th>{t(lang, 'contribution.area')}</th><th>{t(lang, 'contribution.work')}</th><th>{t(lang, 'contribution.context')}</th></tr>
    </thead>
    <tbody>
      {items.map((item) => (
        <tr>
          <th scope="row">{item.area}</th>
          <td><InlineEmphasis text={item.work} /></td>
          <td><InlineEmphasis text={item.context} /></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="table-hint">{t(lang, 'figure.scroll')}</p>

<style>
  .contribution-table { max-width: 100%; overflow-x: auto; border-top: 1px solid var(--rule-strong); }
  table { width: 100%; min-width: 44rem; border-collapse: collapse; table-layout: fixed; }
  th, td { padding: 0.8rem 0.75rem; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; font-size: 0.9375rem; line-height: 1.55; }
  thead th { color: var(--scope); font-size: 0.8125rem; font-weight: 500; }
  th:first-child { width: 16%; padding-left: 0; }
  th:nth-child(2) { width: 49%; }
  tbody th { font-weight: 600; }
  tbody td:last-child { color: var(--ink-muted); }
  td :global(strong) { color: var(--ink); font-weight: 600; }
  .table-hint { margin-top: 0.5rem; font-size: 0.75rem; color: var(--ink-faint); }
  @media (min-width: 52rem) { .table-hint { display: none; } }
</style>
