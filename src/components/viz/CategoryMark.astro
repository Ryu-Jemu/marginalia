---
import Icon from '../Icon.astro';
interface Props { kind: 'ai' | 'analysis' | 'research' | 'more' }
const { kind } = Astro.props;
---
<div class={`category-mark mark-${kind}`} data-network aria-hidden="true">
  {kind === 'analysis' ? (
    <Icon name="chart" size={72}/>
  ) : (
    <svg viewBox="0 0 112 88" fill="none">
      {kind === 'ai' ? <>
        <path class="mark-line" d="M18 22L56 44L94 22M18 66L56 44L94 66M56 44V8" />
        <circle class="mark-node" cx="18" cy="22" r="5" /><circle class="mark-node" cx="18" cy="66" r="5" />
        <circle class="mark-node" cx="94" cy="22" r="5" /><circle class="mark-node" cx="94" cy="66" r="5" />
        <circle class="mark-core" cx="56" cy="44" r="11" /><circle class="mark-pulse" cx="56" cy="44" r="19" />
      </> : kind === 'research' ? <>
        <ellipse class="mark-line" cx="56" cy="44" rx="43" ry="18" transform="rotate(-30 56 44)" />
        <ellipse class="mark-line" cx="56" cy="44" rx="43" ry="18" transform="rotate(30 56 44)" />
        <circle class="mark-core" cx="56" cy="44" r="7" />
        <g class="mark-orbit"><circle class="mark-core" cx="94" cy="44" r="4" /></g>
      </> : <>
        <path class="mark-brackets" d="M32 24L12 44L32 64M80 24L100 44L80 64" />
        <path class="mark-slash" d="M65 18L47 70" />
      </>}
    </svg>
  )}
</div>
<style>
  .category-mark{width:108px;height:88px;margin-top:16px;color:var(--blue)}
  .mark-analysis{display:grid;place-items:center}.mark-analysis :global(.icon){width:70%;height:70%}
  svg{display:block;width:100%;height:100%;overflow:visible}
  .mark-line{stroke:var(--line-strong);stroke-width:1.5}
  .mark-node{fill:var(--paper);stroke:var(--blue);stroke-width:1.5}
  .mark-core{fill:var(--blue)}
  .mark-pulse{stroke:var(--blue);stroke-width:1;opacity:.4;transform-origin:56px 44px;animation:mark-pulse 3.6s ease-in-out infinite paused}
  .mark-orbit{transform-origin:56px 44px;animation:mark-orbit 12s linear infinite paused}
  .mark-brackets{stroke:var(--rule);stroke-width:2}
  .mark-slash{stroke:var(--blue);stroke-width:3;animation:mark-slash 4s ease-in-out infinite paused}
  [data-network-active] .mark-pulse,[data-network-active] .mark-orbit,[data-network-active] .mark-slash{animation-play-state:running}
  .map-mark path{fill:var(--blue-light);stroke:var(--blue);stroke-width:2;transition:fill .2s}
  .category-mark:hover .map-mark path{fill:#c7d8fc}
  @keyframes mark-pulse{0%,100%{transform:scale(.85);opacity:.45}50%{transform:scale(1.12);opacity:.15}}
  @keyframes mark-orbit{to{transform:rotate(360deg)}}
  @keyframes mark-slash{0%,100%{opacity:1}50%{opacity:.4}}
  :global(html[data-motion=off]) .mark-pulse,:global(html[data-motion=off]) .mark-orbit,:global(html[data-motion=off]) .mark-slash{animation:none}
  @media(prefers-reduced-motion:reduce){.mark-pulse,.mark-orbit,.mark-slash{animation:none}}
  @media(max-width:600px){.category-mark{position:absolute;right:4px;top:12px;width:52px;height:42px;margin:0;pointer-events:none}}
  @media print{.category-mark{display:none}}
</style>
