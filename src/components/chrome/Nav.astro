---
import Controls from './Controls.astro';
import { nav } from '../../lib/site';
import { t, altPath, OTHER, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** On a detail page the anchors have to go back to the document first. */
  base?: string;
}
const { lang, base = '' } = Astro.props;
const other = OTHER[lang];
const home = lang === 'ko' ? '/ko/' : '/';
---

<nav class="nav" aria-label={t(lang, 'nav.sections')}>
  <div class="shell nav__inner">
    <a class="nav__home" href={base || home}>
      <span class="nav__name">{t(lang, 'site.name')}</span>
      <span class="nav__role">{t(lang, 'site.role')}</span>
    </a>

    <ul class="nav__list">
      {
        nav(lang, base).map((item) => (
          <li>
            <a class="nav__link" href={item.href} data-nav-link data-watches={item.watches}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__controls">
      {/* The switch carries the other language's name in that language, so a
          reader who cannot read this page can still find the one they want. */}
      <a class="nav__lang" href={altPath(lang, Astro.url.pathname)} lang={other.lang} hreflang={other.lang}>
        {other.label}
      </a>
      <Controls lang={lang} />
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  /* color-mix is well supported, but a solid fallback costs one line. */
  @supports not (backdrop-filter: blur(1px)) {
    .nav {
      background: var(--paper);
    }
  }

  /* Aligned with the document below it, so the bar's left edge and the first
     line of text share a margin. */
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.65rem;
  }

  .nav__home {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    margin-right: auto;
  }
  .nav__name {
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }
  .nav__role {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem 1.15rem;
    flex-wrap: wrap;
  }
  .nav__link {
    display: inline-block;
    font-family: var(--family-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .nav__link:hover {
    color: var(--ink);
  }
  /* The rubric marks where you are, the same colour that marks evidence. */
  .nav__link[aria-current='true'] {
    color: var(--rubric);
    border-bottom-color: currentColor;
  }

  .nav__controls {
    display: flex;
    align-items: center;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
  }
  /* The one control that works without JavaScript, so it is a link and it is
     drawn like the section marks rather than like the reading toggles. */
  .nav__lang {
    font-family: var(--family-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .nav__lang:hover {
    color: var(--rubric);
    border-color: var(--rubric);
  }

  @media (max-width: 60rem) {
    .nav__inner {
      gap: 0.5rem 1rem;
      padding-block: 0.55rem;
    }
    .nav__role {
      display: none;
    }
    .nav__controls {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--rule);
      padding-top: 0.45rem;
    }
  }

  @media (max-width: 34rem) {
    .nav__list {
      order: 2;
      width: 100%;
      gap: 0 0.9rem;
    }
    .nav__home {
      margin-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link,
    .nav__lang {
      transition: none;
    }
  }
</style>
