---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/chrome/Nav.astro';
import Hero from '../components/chrome/Hero.astro';
import NoteLines from '../components/note/NoteLines.astro';
import N from '../components/note/N.astro';
import Section from '../components/doc/Section.astro';
import Bullets from '../components/doc/Bullets.astro';
import ProjectEntry from '../components/work/ProjectEntry.astro';
import PipelineProject from '../components/work/PipelineProject.astro';
import CompactList from '../components/work/CompactList.astro';
import PaperEntry from '../components/research/PaperEntry.astro';
import Figure from '../components/viz/Figure.astro';
import CrimeModel from '../components/viz/CrimeModel.astro';
import CrimeFit from '../components/viz/CrimeFit.astro';
import { site } from '../lib/site';
import { reportMissingMaterials } from '../lib/materials';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const projects = (await getCollection('projects')).sort(byOrder);
const bySlug = (slug: string) => projects.find((p) => p.id.replace(/^tier2\//, '') === slug)!;
const inDomain = (d: string) => projects.filter((p) => p.data.domain === d);

const dartoo = bySlug('dartoo');
const map = bySlug('map');
const researchBuilds = inDomain('research');
const analysis = inDomain('analysis');
const other = inDomain('other');

/* Peer-reviewed first, then under review, then lab work. Collection order is
   the loader's, which is not the order a reviewer wants to read them in. */
const STATUS_RANK = { accepted: 0, revision: 1, 'under-review': 2, assisting: 3 } as const;
const research = (await getCollection('research')).sort(
  (a, b) =>
    STATUS_RANK[a.data.status] - STATUS_RANK[b.data.status] ||
    b.data.date.localeCompare(a.data.date),
);
const record = await getCollection('record');

/** Most recent first. The dates are `YYYY.MM` strings, which sort lexically. */
const newestFirst = (a: { data: { date: string } }, b: { data: { date: string } }) =>
  b.data.date.localeCompare(a.data.date);

const byKind = (kind: string) => record.filter((r) => r.data.kind === kind).sort(newestFirst);
const awards = byKind('award');
const certifications = byKind('certification');
const history = record
  .filter((r) => ['education', 'service', 'lab', 'teaching', 'writing'].includes(r.data.kind))
  .sort(newestFirst);

// Reported once per build, after every page has resolved its own materials.
reportMissingMaterials();
---

<Base
  title={`${site.name} — ${site.role}`}
  description="Data pipelines, wireless-optimisation research, and statistical analysis — with the measurement conditions in the margin beside every figure."
>
  <Nav />

  <Hero />

  <main class="shell">
    <article class="document" data-annotated>
      <NoteLines />

      {/* ── § 1 ─────────────────────────────────────────────────────── */}
      <Section
        id="pipelines"
        n="1"
        title="Data pipelines"
        lede="Two team products. Each is a path data takes from an external source to a phone, and I own most of that path on both. Both were deployed and demonstrated; their servers are powered down now."
      >
        <PipelineProject entry={dartoo} n="1" />
        <PipelineProject entry={map} n="2" />

        <div class="column follow">
          <p class="aside">
            The defects worth opening with were all quiet ones. A publisher that reported success
            while delivering nothing; a finished job that walked backwards into “in
            progress”;<N id="map-terminal-state" /> source archives arriving in three encodings,
            some declaring none at all.<N id="dartoo-normaliser" /> Each project page carries what
            broke, why, and what fixed it.
          </p>
        </div>
      </Section>

      {/* ── § 2 ─────────────────────────────────────────────────────── */}
      <Section
        id="research"
        n="2"
        title="Research"
        lede="Two papers and the lab work behind one of them. Author position is stored as a number and rendered from it, so it cannot drift into a stronger claim. Each paper opens on its own page with the manuscript on it."
      >
        <div class="column column--wide">
          {research.map((entry) => <PaperEntry entry={entry} />)}
        </div>

        <div class="column column--wide research__builds">
          {researchBuilds.map((entry) => <ProjectEntry entry={entry} compact />)}
        </div>
      </Section>

      {/* ── § 3 ─────────────────────────────────────────────────────── */}
      <Section
        id="analysis"
        n="3"
        title="Data analysis"
        lede="Collection, cleaning, the model, and the check that the model is worth reading. Both studies set out to confirm something and did not."
      >
        <div class="column column--wide">
          <Bullets
            key="Seoul crime, twenty-five districts"
            items={[
              'Five variables explain 84% of the variation between districts — R² 0.843, adjusted 0.801.',
              'Population and the density of entertainment venues carry it. CCTV count, the variable the project started from, is not significant.',
              'Variance inflation was checked before any coefficient was read, and the fit was repeated with cross-validated Lasso and Ridge.',
              'Residuals were mapped by district rather than predictions, so where the model is wrong is named.',
            ]}
          />
        </div>

        <div class="column column--wide analysis__figures">
          <Figure n="3" title="Five inputs, one model. The variable the project set out to confirm is the one that failed.">
            <CrimeModel />
          </Figure>
          <Figure n="4" title="What five variables account for, and what they do not.">
            <CrimeFit />
          </Figure>
        </div>

        <div class="column column--wide analysis__entries">
          {analysis.map((entry) => <ProjectEntry entry={entry} compact />)}
        </div>
      </Section>

      {/* ── § 4 ─────────────────────────────────────────────────────── */}
      <Section
        id="more"
        n="4"
        title="More work"
        lede="Services, spikes and coursework, listed as they stand."
      >
        <div class="column">
          <p class="aside aside--lead">
            Twelve repositories of my own, plus the services owned inside two team
            organisations.<N id="repo-spread" /> Three of them exist only to settle a question
            before it reached a real service.<N id="poc-habit" />
          </p>
        </div>
        <div class="column column--wide">
          <CompactList entries={other} />
        </div>
      </Section>

      {/* ── § 5 ─────────────────────────────────────────────────────── */}
      <Section id="about" n="5" title="About" lede="Awards, certifications, and the path here.">
        <div class="column column--wide">
          <div class="record__grid">
            <div>
              <h3 class="record__group">Awards and selections</h3>
              <ul class="record">
                {
                  awards.map((r) => (
                    <li class="record__row">
                      <span class="record__date">{r.data.date}</span>
                      <span class="record__body">
                        <strong>{r.data.title}</strong>
                        <span class="record__issuer">{r.data.issuer}</span>
                        {r.data.detail && <span class="record__detail">{r.data.detail}</span>}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="record__group">Certifications</h3>
              <ul class="record">
                {
                  certifications.map((r) => (
                    <li class="record__row">
                      <span class="record__date">{r.data.date}</span>
                      <span class="record__body">
                        <strong>{r.data.title}</strong>
                        <span class="record__issuer">
                          {r.data.issuer}
                          {r.data.score && ` · ${r.data.score}`}
                        </span>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <h3 class="record__group record__group--wide">Education and service</h3>
          <ul class="record record--two">
            {
              history.map((r) => (
                <li class="record__row">
                  <span class="record__date">{r.data.date}</span>
                  <span class="record__body">
                    <strong>
                      {r.data.href ? (
                        <a href={r.data.href} rel="noopener">
                          {r.data.title}
                        </a>
                      ) : (
                        r.data.title
                      )}
                    </strong>
                    <span class="record__issuer">{r.data.issuer}</span>
                    {r.data.detail && <span class="record__detail">{r.data.detail}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </Section>

      {/* ── contact ─────────────────────────────────────────────────── */}
      <section id="contact" class="contact-block">
        <div class="column column--wide">
          <h2 class="contact__head">Contact</h2>
          <ul class="contact">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.links.github} rel="noopener">github.com/Ryu-Jemu</a></li>
            <li><a href={site.links.blog} rel="noopener">velog.io/@muqqi_bba</a></li>
          </ul>
        </div>
      </section>
    </article>
  </main>
</Base>

<style>
  main {
    padding-block: 0.5rem 4rem;
  }

  .follow {
    margin-top: 1.6rem;
  }
  .aside {
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }
  .aside--lead {
    margin-bottom: 1.1rem;
  }

  .research__builds,
  .analysis__entries {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .analysis__figures {
    margin-top: 1.25rem;
  }

  /* ── record ────────────────────────────────────────────────────────── */
  .record__grid {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 44rem) {
    .record__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem;
    }
  }
  .record__group {
    margin-bottom: 0.7rem;
    font-family: var(--family-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--scope);
    font-weight: 500;
  }
  .record__group--wide {
    margin-top: 1.75rem;
  }
  .record {
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 44rem) {
    .record--two {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 2.25rem;
    }
  }
  .record__row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.15rem 0.85rem;
    align-items: baseline;
  }
  @media (max-width: 30rem) {
    .record__row {
      grid-template-columns: 1fr;
    }
  }
  .record__date {
    font-family: var(--family-mono);
    font-size: var(--t-data);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .record__body {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    font-size: 0.9375rem;
  }
  .record__issuer,
  .record__detail {
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .record__detail {
    color: var(--ink-faint);
  }

  /* ── contact ───────────────────────────────────────────────────────── */
  .contact-block {
    margin-top: var(--space-section);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .contact__head {
    font-size: var(--t-h3);
  }
  .contact {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-family: var(--family-mono);
    font-size: var(--t-data);
  }
</style>
