---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/chrome/Nav.astro';
import NoteLines from '../../components/note/NoteLines.astro';
import Section from '../../components/doc/Section.astro';
import StatusLabel from '../../components/work/StatusLabel.astro';
import Actions from '../../components/work/Actions.astro';
import FixList from '../../components/work/FixList.astro';
import DataPanel from '../../components/doc/DataPanel.astro';
import Devices from '../../components/viz/Devices.astro';
import ProjectFigures from '../../components/viz/ProjectFigures.astro';
import { site } from '../../lib/site';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    // tier-2 entries live in a subdirectory; the URL does not need to say so.
    params: { slug: entry.id.replace(/^tier2\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const p = entry.data;
const slug = entry.id.replace(/^tier2\//, '');
const { Content } = await render(entry);

const backTo =
  p.domain === 'pipeline'
    ? '#pipelines'
    : p.domain === 'research'
      ? '#research'
      : p.domain === 'analysis'
        ? '#analysis'
        : '#more';

let n = 0;
const next = () => String(++n);
---

<Base title={`${p.title} — ${site.name}`} description={p.tagline}>
  <Nav base="/" />

  <main class="shell">
    <article class="document" data-annotated>
      <NoteLines />

      <header class="column head">
        <p class="head__back"><a href={`/${backTo}`}>&larr; Back</a></p>
        <p class="meta head__meta">
          <span>{p.period}</span>
          <span class="head__sep">·</span>
          <span>{p.team}</span>
          <StatusLabel status={p.status} />
        </p>
        <h1>{p.title}</h1>
        <p class="head__tagline">{p.tagline}</p>
        <p class="meta head__role">{p.role}</p>

        {
          p.links.length > 0 && (
            <Actions actions={p.links.map((l) => ({ href: l.href, label: l.label, kind: l.kind }))} />
          )
        }
      </header>

      {
        p.data.length > 0 && (
          <div class="column column--wide head__panel">
            <DataPanel items={p.data} />
          </div>
        )
      }

      <Section id="scope" n={next()} title="Scope">
        <div class="column column--wide scope">
          <div>
            <p class="meta scope__key">What I owned</p>
            <ul class="scope__list">
              {p.ownership.owned.map((o) => <li>{o}</li>)}
            </ul>
          </div>
          {
            p.ownership.notOwned.length > 0 && (
              <div>
                <p class="meta scope__key scope__key--not">What I did not own</p>
                <ul class="scope__list scope__list--not">
                  {p.ownership.notOwned.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </Section>

      <Section id="what" n={next()} title="What it does">
        <div class="column prose">
          <Content />
        </div>
        <div class="column column--wide">
          <Devices slug={slug} />
          <ProjectFigures slug={slug} />
        </div>
      </Section>

      {
        p.fixes.length > 0 && (
          <Section
            id="fixes"
            n={next()}
            title="Defects I found and fixed"
            lede="Symptom, cause, fix — in the order they were learned."
          >
            <div class="column column--wide">
              <FixList fixes={p.fixes} />
            </div>
          </Section>
        )
      }

      <Section id="stack" n={next()} title="Built with">
        <div class="column column--wide">
          <ul class="stack">
            {p.stack.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </Section>
    </article>
  </main>
</Base>

<style>
  main {
    padding-block: 1.75rem 5rem;
  }

  .head__back {
    font-family: var(--family-mono);
    font-size: var(--t-data);
    margin-bottom: 1.5rem;
  }
  .head__back a {
    color: var(--ink-faint);
    text-decoration: none;
  }
  .head__back a:hover {
    color: var(--rubric);
  }
  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
  }
  .head__sep {
    color: var(--rule-strong);
  }
  .head__tagline {
    margin-top: 0.8rem;
    font-size: var(--t-lede);
    line-height: var(--lh-lede);
    font-weight: 400;
    color: var(--ink-muted);
  }
  .head__role {
    margin-top: 0.9rem;
  }
  .head__panel {
    margin-top: 1.5rem;
  }

  .scope {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 34rem) {
    .scope {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem;
    }
  }
  .scope__key {
    color: var(--scope);
    margin-bottom: 0.45rem;
  }
  .scope__key--not {
    color: var(--boundary);
  }
  .scope__list {
    display: grid;
    gap: 0.35rem;
    font-size: 0.97em;
  }
  .scope__list li {
    position: relative;
    padding-left: 1rem;
  }
  .scope__list li::before {
    content: '·';
    position: absolute;
    left: 0.15rem;
    color: var(--rule-strong);
  }
  .scope__list--not {
    color: var(--ink-faint);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  .stack li {
    font-family: var(--family-mono);
    font-size: var(--t-data);
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.25em 0.7em;
  }
</style>
