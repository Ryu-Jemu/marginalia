---
import Base from '../../layouts/Base.astro';
import { projectsOf, researchOf, workHref } from '../../lib/content';
import About from '../About.astro';
import ProjectPreview from '../viz/ProjectPreview.astro';
import CategoryMark from '../viz/CategoryMark.astro';
import AnalysisThumbnail from '../viz/AnalysisThumbnail.astro';
import Icon from '../Icon.astro';
import TechnologyOverview from '../TechnologyOverview.astro';
import '../../styles/home.css';

const projects = await projectsOf();
const papers = await researchOf();
const featured = ['map', 'dartoo'].map(id => projects.find(p => p.id === id)!);
const groups = [
  { id: 'ai-projects', title: 'AI', projects: projects.filter(p => p.data.category === 'ai') },
  { id: 'analysis', title: '분석', projects: projects.filter(p => p.data.category === 'analysis') },
];
const more = projects.filter(p => p.data.category === 'other');
---
<Base>
  <div class="wrap home-page">
    <About />

    <section class="selected-work" id="pipelines" aria-labelledby="selected-title">
      <div class="work-heading">
        <h2 id="selected-title"><Icon name="layers" size={24}/>프로젝트</h2>
        <span>AI · 백엔드 · 모바일</span>
      </div>
      <TechnologyOverview/>
      <div class="selected-grid">
        {featured.map(p => (
          <article class="selected-project" data-reveal>
            <a class="project-cover" href={workHref(p.id)} aria-label={`${p.data.title} 프로젝트 보기`}>
              <ProjectPreview project={p.id as 'map' | 'dartoo'} />
            </a>
            <div class="selected-body">
            <div class="selected-heading">
              <h3><a href={workHref(p.id)}>{p.data.title} <Icon name="arrow-up-right" size={23} class="selected-title-arrow"/></a></h3>
              <span>{p.id === 'map' ? 'App Store 출시' : '공시 요약 · 구독 알림'}</span>
            </div>
            <p class="selected-description">{p.id === 'map' ? '장소 탐색부터 일정 저장까지, AI 여행 도우미' : '공시 원문을 요약과 알림으로 연결하는 서비스'}</p>
            <ul class="selected-points">
              {p.data.summary.map((line, i) => <li><span>{['기능', '기여', '개선'][i]}</span>{line}</li>)}
            </ul>
            {p.data.cloud && <a class="selected-cloud" href={`${workHref(p.id)}#cloud`}><Icon name="cloud" size={19}/><span>{p.data.cloud.summary}</span><Icon name="arrow-up-right" size={16}/></a>}
            <div class="selected-links">
              <a href={workHref(p.id)}><Icon name="code" size={18} tone="inherit"/>상세 <Icon name="arrow-up-right" size={18}/></a>
              {p.id === 'map' && <a href="https://apps.apple.com/kr/app/m-a-p/id6811266533"><Icon name="smartphone" size={18}/>App Store</a>}
            </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="project-directory">
      {groups.map(group => (
        <section class="directory-group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <div class="directory-label"><h2 id={`${group.id}-title`}>{group.title}</h2><CategoryMark kind={group.id === 'analysis' ? 'analysis' : 'ai'} /></div>
          <ul class="directory-list">
            {group.projects.map(p => (
              <li><a href={workHref(p.id)} class:list={{ 'analysis-row': group.id === 'analysis' }}>
                {group.id === 'analysis' && <AnalysisThumbnail kind={p.id === 'crime-analysis' ? 'crime' : 'cinema'} />}
                <div class:list={{ 'analysis-row-copy': group.id === 'analysis' }}><h3>{p.data.title}</h3><p>{p.data.tagline}</p></div>
                <span class="directory-arrow" aria-hidden="true">↗</span>
              </a></li>
            ))}
          </ul>
        </section>
      ))}

      <section class="directory-group" id="research" aria-labelledby="research-title">
        <div class="directory-label"><h2 id="research-title">연구</h2><CategoryMark kind="research" /></div>
        <ul class="directory-list">
          {papers.map(p => (
            <li><a href={`/research/${p.id}/`}>
              <div><h3>{p.data.shortTitle}</h3><p>{p.data.venue} · {p.data.authorPosition.index === 1 ? '제1저자' : `공동저자 ${p.data.authorPosition.index}/${p.data.authorPosition.of}`} · {p.data.status === 'accepted' ? '논문 채택' : '심사 중'}</p></div>
              <span class="directory-arrow" aria-hidden="true">↗</span>
            </a></li>
          ))}
        </ul>
      </section>

      <section class="directory-group" id="more" aria-labelledby="more-title">
        <div class="directory-label"><h2 id="more-title">기타</h2><CategoryMark kind="more" /></div>
        <ul class="directory-list">
          {more.map(p => (
            <li><a href={workHref(p.id)}>
              <div><h3>{p.data.title}</h3><p>{p.data.tagline}</p></div>
              <span class="directory-arrow" aria-hidden="true">↗</span>
            </a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>
