---
import type { CollectionEntry } from 'astro:content';
import StatusLabel from './StatusLabel.astro';
import Actions from './Actions.astro';
import { t, localise, type Lang } from '../../i18n/ui';
import { slugOf } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'projects'>;
  compact?: boolean;
  /** Heading level, so a project can sit under a section or under a subsection. */
  as?: 'h3' | 'h4';
  lang?: Lang;
}

const { entry, compact = false, as = 'h3', lang = 'en' } = Astro.props;
const p = entry.data;
const href = localise(lang, `/work/${slugOf(entry)}/`);
const Heading = as;

const actions = [
  ...p.links.map((l) => ({ href: l.href, label: l.label, kind: l.kind })),
  { href, label: t(lang, 'work.built'), kind: 'detail' as const },
];
---

<article class:list={['entry', compact && 'entry--compact']}>
  <p class="meta entry__meta">
    <span>{p.period}</span>
    <span class="entry__sep">·</span>
    <span>{p.team}</span>
    <StatusLabel status={p.status} lang={lang} />
  </p>

  <Heading class="entry__title"><a href={href}>{p.title}</a></Heading>
  <p class="entry__tagline">{p.tagline}</p>

  {
    !compact && (
      <p class="meta entry__role">
        <span class="entry__key">{t(lang, 'work.owned')}</span> {p.ownership.owned.join(' · ')}
      </p>
    )
  }

  <Actions actions={actions} />
</article>

<style>
  .entry {
    padding-bottom: 0.2rem;
  }
  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .entry__sep {
    color: var(--rule-strong);
  }
  .entry__title {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
  }
  .entry--compact {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .entry--compact:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .entry--compact .entry__title {
    font-size: 1.0625rem;
  }
  .entry__title a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  .entry__title a:hover {
    color: var(--rubric);
    border-bottom-color: currentColor;
  }
  .entry__tagline {
    margin-top: 0.3rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }
  .entry__role {
    margin-top: 0.5rem;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.55;
  }
  .entry__key {
    text-transform: uppercase;
    letter-spacing: var(--ls-meta);
    color: var(--scope);
  }
</style>
