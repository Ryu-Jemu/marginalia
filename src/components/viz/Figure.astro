---
/**
 * A plate in the document.
 *
 * Tufte's method is not "less ink" — it is putting the graphic where the
 * sentence that needs it is. Every figure here draws data the surrounding
 * prose already states, so the two can be checked against each other.
 *
 * The caption is numbered like a paper's, and the SVG is hidden from assistive
 * technology because the caption and the prose carry the same content.
 */
interface Props {
  n: string;
  title: string;
  /** Wider than the reading column, spilling into the margin. */
  wide?: boolean;
}
const { n, title, wide = false } = Astro.props;
---

<figure class:list={['figure', wide && 'figure--wide']}>
  <div class="figure__plate"><slot /></div>
  <figcaption class="figure__caption">
    <span class="figure__n">Fig. {n}</span>
    {title}
  </figcaption>
</figure>

<style>
  .figure {
    margin-block: 1.4rem;
  }
  @media (min-width: 64rem) {
    /* A wide plate uses the note column, so it has to start below any note
       already floating there — otherwise the two draw on top of each other. */
    .figure {
      clear: right;
    }
  }
  @media (min-width: 64rem) {
    /* Let a figure use the note column too. The notes clear around it. */
    .figure--wide {
      width: calc(var(--measure) + var(--gutter) + var(--note-w));
    }
  }
  .figure__plate {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: 1.1rem;
  }
  .figure__caption {
    margin-top: 0.5rem;
    font-family: var(--family-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-faint);
    text-wrap: pretty;
  }
  .figure__n {
    color: var(--rubric);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    margin-right: 0.5em;
  }
</style>

<style is:global>
  /* Shared vocabulary for every diagram, so they read as one set. */
  .viz {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .viz text {
    font-family: var(--family-mono);
    fill: var(--ink-muted);
  }
  .viz .viz-label {
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--ink-faint);
  }
  .viz .viz-value {
    font-size: 13px;
    fill: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .viz .viz-value--rubric {
    fill: var(--rubric);
  }
  .viz .viz-value--boundary {
    fill: var(--boundary);
  }
  .viz .viz-rule {
    stroke: var(--rule-strong);
    stroke-width: 1;
    fill: none;
  }
  .viz .viz-track {
    stroke: var(--rule);
    stroke-width: 1;
    fill: none;
  }
  .viz .viz-ink {
    stroke: var(--ink);
    stroke-width: 1.25;
    fill: none;
  }
  .viz .viz-accent {
    stroke: var(--rubric);
    stroke-width: 1.25;
    fill: none;
  }
  .viz .viz-limit {
    stroke: var(--boundary);
    stroke-width: 1.25;
    fill: none;
  }
  .viz .viz-fill-ink {
    fill: var(--ink);
    stroke: none;
  }
  .viz .viz-fill-accent {
    fill: var(--rubric);
    stroke: none;
  }
  .viz .viz-fill-boundary {
    fill: var(--boundary);
    stroke: none;
  }
  .viz .viz-box {
    fill: var(--paper-inset);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
</style>
