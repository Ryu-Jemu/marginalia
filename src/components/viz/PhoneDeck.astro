---
import { Image } from 'astro:assets';
import { t, type Lang } from '../../i18n/ui';

/**
 * One device, whose screen the reader advances.
 *
 * A row of five framed screenshots asks a reader to compare them; a product is
 * not used that way. One phone with a control either side of it is closer to
 * what the thing is, and unlike a scroll-driven version it moves only when
 * someone asks it to.
 *
 * The fallback is the row. Markup ships every screen in the flow, and the
 * script collapses them into a single frame only once it has run — so with
 * scripting off, or if the initialiser throws, the screens are all still on
 * the page rather than nine tenths of them being invisible. The arrows ship
 * hidden for the same reason: a control that cannot work should not appear.
 */
interface Shot {
  src: ImageMetadata;
  alt: string;
  screen: string;
}
interface Props {
  shots: Shot[];
  lang?: Lang;
}
const { shots, lang = 'en' } = Astro.props;
const ratio = shots.length > 0 ? `${shots[0].src.width} / ${shots[0].src.height}` : '9 / 19.5';
---

{
  shots.length > 0 && (
    <div class="deck" data-phone-deck data-notes-inline>
      <div class="deck__stage">
        <button
          class="deck__arrow deck__arrow--prev"
          type="button"
          data-deck-step="-1"
          aria-label={t(lang, 'deck.prev')}
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 4 L7 12 L15 20" />
          </svg>
        </button>

        <div class="deck__frame">
          <div class="deck__screen" style={`--ratio:${ratio}`}>
            {shots.map((s, i) => (
              <figure class="deck__shot" data-deck-shot data-i={i}>
                <Image
                  class="deck__img"
                  src={s.src}
                  alt={s.alt}
                  widths={[300, 600]}
                  sizes="(max-width: 40rem) 60vw, 15rem"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <figcaption class="deck__caption">{s.screen}</figcaption>
              </figure>
            ))}
          </div>
          <span class="deck__island" aria-hidden="true" />
          <span class="deck__btn deck__btn--vol" aria-hidden="true" />
          <span class="deck__btn deck__btn--pwr" aria-hidden="true" />
        </div>

        <button
          class="deck__arrow deck__arrow--next"
          type="button"
          data-deck-step="1"
          aria-label={t(lang, 'deck.next')}
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 4 L17 12 L9 20" />
          </svg>
        </button>

        <div class="deck__meter" data-deck-meter hidden>
          <p class="deck__now" data-deck-label>{shots[0].screen}</p>
          <ol class="deck__dots">
            {shots.map((s, i) => (
              <li>
                <button
                  class="deck__dot"
                  type="button"
                  data-deck-dot
                  data-i={i}
                  aria-label={t(lang, 'deck.show', { screen: s.screen })}
                />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  )
}

<style>
  /* ── fallback: every screen framed, side by side ─────────────────────── */
  .deck__screen {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .deck__shot {
    margin: 0;
    width: 9rem;
  }
  .deck__img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 0.75rem;
    background: var(--paper-inset);
  }
  .deck__caption {
    margin-top: 0.4rem;
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .deck__frame {
    position: relative;
  }
  .deck__island,
  .deck__btn {
    display: none;
  }

  /* ── once the script has collapsed the stack ─────────────────────────── */
  .deck[data-stacked] .deck__stage {
    display: grid;
    grid-template-columns: auto minmax(0, 15rem) auto;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
  }
  .deck[data-stacked] .deck__frame {
    grid-column: 2;
    width: 100%;
    padding: 0.45rem;
    border-radius: 2.1rem;
    background: linear-gradient(160deg, var(--rule-strong), var(--ink-muted));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.16),
      0 16px 34px -16px rgb(0 0 0 / 0.42);
  }
  .deck[data-stacked] .deck__screen {
    display: block;
    position: relative;
    border-radius: 1.7rem;
    overflow: hidden;
    background: var(--paper-inset);
    aspect-ratio: var(--ratio);
  }
  .deck[data-stacked] .deck__shot {
    position: absolute;
    inset: 0;
    width: auto;
  }
  .deck[data-stacked] .deck__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    border: 0;
    border-radius: 0;
  }
  .deck[data-stacked] .deck__caption {
    display: none;
  }
  /* The cut-out is hardware, so it keeps its own near-black in both themes. */
  .deck[data-stacked] .deck__island {
    display: block;
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 3.2rem;
    height: 0.66rem;
    border-radius: 0.4rem;
    background: #0d0d0f;
  }
  .deck[data-stacked] .deck__btn {
    display: block;
    position: absolute;
    width: 2px;
    border-radius: 2px;
    background: var(--rule-strong);
  }
  .deck[data-stacked] .deck__btn--vol {
    left: -2px;
    top: 24%;
    height: 12%;
  }
  .deck[data-stacked] .deck__btn--pwr {
    right: -2px;
    top: 30%;
    height: 16%;
  }

  /* ── the controls ────────────────────────────────────────────────────── */
  .deck__arrow {
    appearance: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color 140ms ease,
      border-color 140ms ease;
  }
  .deck__arrow[hidden] {
    display: none;
  }
  .deck__arrow--prev {
    grid-column: 1;
  }
  .deck__arrow--next {
    grid-column: 3;
  }
  .deck__arrow svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .deck__arrow:hover:not(:disabled) {
    color: var(--rubric);
    border-color: var(--rubric);
  }
  /* Kept in the layout when it runs out of screens, so the frame does not
     shift sideways at either end of the set. */
  .deck__arrow:disabled {
    color: var(--rule-strong);
    border-color: var(--rule);
    cursor: default;
  }

  .deck__meter {
    grid-column: 2;
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    margin-top: 0.85rem;
  }
  .deck__now {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .deck__dots {
    display: flex;
    gap: 0.3rem;
  }
  .deck__dot {
    display: block;
    width: 1.4rem;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--rule-strong);
    cursor: pointer;
    transition: background-color 160ms ease;
  }
  .deck__dot[aria-current='true'] {
    background: var(--rubric);
  }

  @media (prefers-reduced-motion: reduce) {
    .deck__dot,
    .deck__arrow {
      transition: none;
    }
  }

  /* In print the stack is useless — put the row back. */
  @media print {
    .deck[data-stacked] .deck__shot {
      position: static;
      width: 9rem;
    }
    .deck[data-stacked] .deck__screen {
      display: flex;
      aspect-ratio: auto;
    }
    .deck[data-stacked] .deck__frame {
      background: none;
      box-shadow: none;
      padding: 0;
    }
    .deck[data-stacked] .deck__caption {
      display: block;
    }
    .deck__meter,
    .deck__arrow {
      display: none;
    }
  }
</style>
