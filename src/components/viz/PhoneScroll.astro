---
import { Image } from 'astro:assets';

/**
 * One device, whose screen advances as the page moves past it.
 *
 * A row of five framed screenshots asks a reader to compare them; a product is
 * not used that way. One phone, and scrolling walks through it, is closer to
 * what the thing is.
 *
 * The fallback is the row. Markup ships every screen in the flow, and the
 * script collapses them into a single frame only once it has run — so with
 * scripting off, or if the initialiser throws, the screens are all still on
 * the page rather than nine tenths of them being invisible.
 */
interface Shot {
  src: ImageMetadata;
  alt: string;
  screen: string;
}
interface Props {
  shots: Shot[];
  /** Aspect of the frame; taken from the first capture. */
  label?: string;
}
const { shots } = Astro.props;
const ratio = shots.length > 0 ? `${shots[0].src.width} / ${shots[0].src.height}` : '9 / 19.5';
---

{
  shots.length > 0 && (
    <div class="deck" data-phone-deck data-notes-inline>
      <div class="deck__stage">
        <div class="deck__frame">
          <div class="deck__screen" style={`--ratio:${ratio}`}>
            {shots.map((s, i) => (
              <figure class="deck__shot" data-deck-shot data-i={i}>
                <Image
                  class="deck__img"
                  src={s.src}
                  alt={s.alt}
                  widths={[300, 600]}
                  sizes="(max-width: 40rem) 60vw, 15rem"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                <figcaption class="deck__caption">{s.screen}</figcaption>
              </figure>
            ))}
          </div>
          <span class="deck__island" aria-hidden="true" />
          <span class="deck__btn deck__btn--vol" aria-hidden="true" />
          <span class="deck__btn deck__btn--pwr" aria-hidden="true" />
        </div>

        <div class="deck__meter" data-deck-meter hidden>
          <p class="deck__now" data-deck-label>{shots[0].screen}</p>
          <ol class="deck__dots">
            {shots.map((s, i) => (
              <li>
                <button
                  class="deck__dot"
                  type="button"
                  data-deck-dot
                  data-i={i}
                  aria-label={`Show ${s.screen}`}
                />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  )
}

<style>
  /* ── fallback: every screen framed, side by side ─────────────────────── */
  .deck__screen {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .deck__shot {
    margin: 0;
    width: 9rem;
  }
  .deck__img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 0.75rem;
    background: var(--paper-inset);
  }
  .deck__caption {
    margin-top: 0.4rem;
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .deck__frame {
    position: relative;
  }
  .deck__island,
  .deck__btn {
    display: none;
  }

  /* ── once the script has collapsed the stack ─────────────────────────── */
  .deck[data-stacked] .deck__stage {
    display: grid;
    gap: 0.85rem;
    justify-items: center;
    width: 100%;
    max-width: 15rem;
  }
  .deck[data-stacked] .deck__frame {
    width: 100%;
    padding: 0.45rem;
    border-radius: 2.1rem;
    background: linear-gradient(160deg, var(--rule-strong), var(--ink-muted));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.16),
      0 16px 34px -16px rgb(0 0 0 / 0.42);
  }
  .deck[data-stacked] .deck__screen {
    display: block;
    position: relative;
    border-radius: 1.7rem;
    overflow: hidden;
    background: var(--paper-inset);
    aspect-ratio: var(--ratio);
  }
  .deck[data-stacked] .deck__shot {
    position: absolute;
    inset: 0;
    width: auto;
  }
  .deck[data-stacked] .deck__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    border: 0;
    border-radius: 0;
  }
  .deck[data-stacked] .deck__caption {
    display: none;
  }
  /* The cut-out is hardware, so it keeps its own near-black in both themes. */
  .deck[data-stacked] .deck__island {
    display: block;
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 3.2rem;
    height: 0.66rem;
    border-radius: 0.4rem;
    background: #0d0d0f;
  }
  .deck[data-stacked] .deck__btn {
    display: block;
    position: absolute;
    width: 2px;
    border-radius: 2px;
    background: var(--rule-strong);
  }
  .deck[data-stacked] .deck__btn--vol {
    left: -2px;
    top: 24%;
    height: 12%;
  }
  .deck[data-stacked] .deck__btn--pwr {
    right: -2px;
    top: 30%;
    height: 16%;
  }

  .deck__meter {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
  }
  .deck__now {
    font-family: var(--family-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .deck__dots {
    display: flex;
    gap: 0.3rem;
  }
  .deck__dot {
    display: block;
    width: 1.4rem;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--rule-strong);
    cursor: pointer;
    transition: background-color 160ms ease;
  }
  .deck__dot[aria-current='true'] {
    background: var(--rubric);
  }

  @media (prefers-reduced-motion: reduce) {
    .deck__dot {
      transition: none;
    }
  }

  /* In print the stack is useless — put the row back. */
  @media print {
    .deck[data-stacked] .deck__shot {
      position: static;
      width: 9rem;
    }
    .deck[data-stacked] .deck__screen {
      display: flex;
      aspect-ratio: auto;
    }
    .deck[data-stacked] .deck__frame {
      background: none;
      box-shadow: none;
      padding: 0;
    }
    .deck[data-stacked] .deck__caption {
      display: block;
    }
    .deck__meter {
      display: none;
    }
  }
</style>
