---
/**
 * A margin note anchored to a claim in the running text.
 *
 * The marker and the note are adjacent siblings, which buys three things:
 *   - pairing is `ref.nextElementSibling`, so no ids and no duplicate-id bugs
 *   - the numbering is a pure CSS counter, correct without JS
 *   - a screen reader meets the note where the claim is, then returns
 *
 * Both are `<span>` because `<aside>` is flow content and cannot sit inside a
 * `<p>`; Astro 7's compiler is strict about this.
 */
import { noteOf } from '../../lib/content';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  id: string;
  lang?: Lang;
}

const { id, lang = 'en' } = Astro.props;

const entry = await noteOf(lang, id);
if (!entry) {
  const file = lang === 'ko' ? 'src/content/ko/notes.yaml' : 'src/content/notes.yaml';
  throw new Error(`Unknown note id: "${id}" — add it to ${file}`);
}
const n = entry.data;
---

<span
  class="note-ref"
  data-note-ref
  role="button"
  tabindex="0"
  aria-expanded="true"
  aria-label={t(lang, 'note.aria', { body: n.body.slice(0, 80) })}></span><span
  class="note"
  data-note
  data-kind={n.kind}
  role="note"
  ><span class="note__body">{n.body}</span>{
    n.condition && (
      <span class="note__meta note__meta--scope">
        <span class="note__meta-key">{t(lang, 'note.measured')}</span> {n.condition}
      </span>
    )
  }{
    n.href && (
      <a class="note__meta note__meta--source" href={n.href} rel="noopener">
        {t(lang, 'note.source')}
      </a>
    )
  }</span
>
