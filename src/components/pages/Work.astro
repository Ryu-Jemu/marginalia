---
import Base from '../../layouts/Base.astro';
import '../../styles/detail.css';
import type {Project} from '../../lib/content';
import ProductScreens from '../viz/ProductScreens.astro';
import WebScreens from '../viz/WebScreens.astro';
import { webScreens } from '../../data/web-screens';
import CloudEnvironment from '../CloudEnvironment.astro';
import TechBadge from '../TechBadge.astro';
import TechnologyChoices from '../TechnologyChoices.astro';
import { technologyChoices } from '../../data/project-technology';
import FlowDiagram from '../viz/FlowDiagram.astro';
import CrimeStudy from '../viz/CrimeStudy.astro';
import CinemaStudy from '../viz/CinemaStudy.astro';
import PricingResults from '../viz/PricingResults.astro';
import BeamMethodStudy from '../viz/BeamMethodStudy.astro';
import StarCases from '../StarCases.astro';
import Icon from '../Icon.astro';
import ArchitectureDiagram from '../viz/ArchitectureDiagram.astro';
import { architectures } from '../../data/architectures';
interface Props { project: Project }
const {project} = Astro.props;
const p = project.data;
const architecture = architectures[project.id];
const choices = technologyChoices[project.id];
const linkIcon = (href: string): 'code' | 'book' | 'smartphone' | 'link' => href.includes('github.com/') ? 'code' : href.includes('apps.apple.com/') ? 'smartphone' : href.startsWith('/research/') || /\.pdf(?:[?#]|$)/.test(href) ? 'book' : 'link';
const hasPhoneScreens = ['map', 'dartoo'].includes(project.id);
const webScreenSet = webScreens[project.id];
const hasScreens = hasPhoneScreens || Boolean(webScreenSet);
const hasVisual = p.category === 'analysis' || p.category === 'research';
const researchId = project.id === 'network-pricing' ? 'ask-2026' : project.id === 'bp-llm' ? 'ieee-tai-survey' : null;
const returnAnchor = p.category === 'ai' ? 'ai-projects' : p.category === 'analysis' ? 'analysis' : p.category === 'research' ? 'research' : p.category === 'other' ? 'more' : 'pipelines';
---
<Base title={`${p.title} · 류제무 포트폴리오`} description={p.tagline}>
  <div class:list={['wrap detail-wrap document-detail', {'architecture-detail': architecture}]}>
    <header class="detail-header">
      <a class="back-link" href={`/#${returnAnchor}`}>← 포트폴리오</a>
      <div class="project-kicker"><span>{p.status}</span><span>{p.team}</span></div>
      <h1>{p.title}</h1>
      <p class="detail-lede">{p.tagline}</p>
      <p class="detail-role"><strong>담당</strong><span>{p.role}</span></p>
      <ul class="chips" aria-label="사용 기술">{p.stack.map(s => <li><TechBadge name={s}/></li>)}</ul>
      <div class="detail-links">
        {p.links.map(l => <a href={l.href}><Icon name={linkIcon(l.href)} size={18}/>{l.label}<Icon name="arrow-up-right" size={15}/></a>)}
        {researchId && !p.links.some(l => l.href === `/research/${researchId}/`) && <a href={`/research/${researchId}/`}><Icon name="book" size={18}/>관련 연구<Icon name="arrow-up-right" size={15}/></a>}
      </div>
    </header>

    <div class="detail-layout">
      <aside class="detail-sidebar">
        <nav class="detail-nav" aria-label="프로젝트 목차" data-section-nav>
          <span class="detail-nav-title">목차</span>
          {hasScreens && <a href="#screens"><Icon name={hasPhoneScreens ? 'smartphone' : 'code'} size={17}/>화면</a>}
          {hasVisual && <a href="#overview"><Icon name={p.category === 'analysis' ? 'chart' : 'book'} size={17}/>시각화</a>}
          <a href="#features"><Icon name="grid" size={17}/>기능</a>
          <a href="#contribution"><Icon name="user" size={17}/>기여</a>
          {choices && <a href="#technology"><Icon name="code" size={17}/>기술</a>}
          <a href="#architecture"><Icon name={p.category === 'analysis' ? 'chart' : 'layers'} size={17}/>구조</a>
          {p.cloud && <a href="#cloud"><Icon name="cloud" size={17}/>클라우드</a>}
          {p.cases.length > 0 && <a href="#troubleshooting"><Icon name="tool" size={17}/>트러블슈팅</a>}
          {p.outcomes.length > 0 && <a href="#outcomes"><Icon name="check" size={17}/>결과</a>}
        </nav>
      </aside>

      <div class="detail-body">
        {hasPhoneScreens && <section class="detail-section detail-screens" id="screens">
          <h2><Icon name="smartphone" size={22}/>화면</h2>
          <ProductScreens project={project.id as 'map' | 'dartoo'}/>
        </section>}
        {webScreenSet && <section class="detail-section detail-web-screens" id="screens">
          <h2><Icon name="code" size={22}/>화면</h2>
          <WebScreens {...webScreenSet}/>
        </section>}
        {hasVisual && <section class="detail-section detail-visual" id="overview">
          <h2><Icon name={p.category === 'analysis' ? 'chart' : 'book'} size={22}/>시각화</h2>
          {project.id === 'crime-analysis' && <CrimeStudy/>}
          {project.id === 'cinema-dashboard' && <CinemaStudy/>}
          {project.id === 'network-pricing' && <PricingResults/>}
          {project.id === 'bp-llm' && <BeamMethodStudy/>}
        </section>}

        <section class="detail-section" id="features">
          <h2><Icon name="grid" size={22}/>기능</h2>
          <dl class="detail-features">{p.features.map(f => <div><dt>{f.title}</dt><dd>{f.detail}</dd></div>)}</dl>
        </section>

        <section class="detail-section" id="contribution">
          <h2><Icon name="user" size={22}/>기여</h2>
          <div class="contribution-list">{p.contributions.map(c => <article><h3>{c.area}</h3><div><p>{c.work}</p><p class="contribution-context">{c.context}</p></div></article>)}</div>
        </section>

        {choices && <section class="detail-section" id="technology">
          <h2><Icon name="code" size={22}/>기술</h2>
          <TechnologyChoices choices={choices}/>
        </section>}

        <section class="detail-section" id="architecture">
          <h2><Icon name={p.category === 'analysis' ? 'chart' : 'layers'} size={22}/>구조</h2>
          {architecture ? <ArchitectureDiagram model={architecture}/> : <>
            <FlowDiagram stages={p.flow} label={`${p.title}의 주요 처리 흐름`} compact/>
            {p.architecture.length > 0 && <div class="architecture-groups">{p.architecture.map(group => <section><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></section>)}</div>}
          </>}
        </section>

        {p.cloud && <section class="detail-section" id="cloud">
          <h2><Icon name="cloud" size={22}/>클라우드</h2>
          <CloudEnvironment cloud={p.cloud}/>
        </section>}

        {p.cases.length > 0 && <section class="detail-section" id="troubleshooting">
          <h2><Icon name="tool" size={22}/>트러블슈팅</h2>
          <StarCases cases={p.cases}/>
        </section>}

        {p.outcomes.length > 0 && <section class="detail-section outcomes" id="outcomes">
          <h2><Icon name="check" size={22}/>결과</h2>
          <ul class="prose-list">{p.outcomes.map(x => <li>{x}</li>)}</ul>
        </section>}

        <footer class="detail-bottom"><a class="back-link" href={`/#${returnAnchor}`}>← 다른 프로젝트 보기</a></footer>
      </div>
    </div>
  </div>
</Base>
