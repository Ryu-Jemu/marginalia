---
import PhoneScroll from './PhoneScroll.astro';

import dartooStart from '../../assets/projects/dartoo/screen-start.png';
import dartooHome from '../../assets/projects/dartoo/screen-home.png';
import dartooDisclosure from '../../assets/projects/dartoo/screen-disclosure.png';
import dartooCompany from '../../assets/projects/dartoo/screen-company.png';
import dartooChat from '../../assets/projects/dartoo/screen-chat.png';

import mapHome from '../../assets/projects/map/screen-home.png';
import mapItinerary from '../../assets/projects/map/screen-itinerary.png';
import mapPlace from '../../assets/projects/map/screen-place.png';

/**
 * Which screens belong to which product, kept out of the content files so a
 * device frame stays a rendering decision rather than a data one.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const SETS: Record<string, Array<{ src: ImageMetadata; alt: string; screen: string }>> = {
  dartoo: [
    { src: dartooStart, alt: 'Dartoo — sign-in screen', screen: 'Sign in' },
    { src: dartooHome, alt: 'Dartoo — the day’s filings and watched companies', screen: 'Today' },
    { src: dartooDisclosure, alt: 'Dartoo — a filing with its generated summary', screen: 'Filing' },
    { src: dartooCompany, alt: 'Dartoo — a company page with its filing history', screen: 'Company' },
    { src: dartooChat, alt: 'Dartoo — the assistant answering a question about a filing', screen: 'Ask' },
  ],
  map: [
    { src: mapHome, alt: 'MAP — home, with the trip countdown and the day’s weather', screen: 'Home' },
    { src: mapItinerary, alt: 'MAP — a generated itinerary with the route drawn', screen: 'Itinerary' },
    { src: mapPlace, alt: 'MAP — a place with its photo, rating and review summary', screen: 'Place' },
  ],
};

const shots = SETS[slug] ?? [];
---

{shots.length > 0 && <PhoneScroll shots={shots} />}
