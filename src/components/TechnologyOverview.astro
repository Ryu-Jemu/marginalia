---
import TechBadge from './TechBadge.astro';
import Icon from './Icon.astro';
import {featuredTechnology,developmentTools} from '../data/technology';
---
<div class="technology-overview" aria-label="프로젝트에 사용한 기술과 개발 도구">
  <div class="technology-overview-title"><h3>기술</h3><span>AI부터 서비스·클라우드까지</span></div>
  <dl class="technology-groups">
    {featuredTechnology.map(group => <div><dt>{group.label}</dt><dd><ul>{group.names.map(name => <li><TechBadge name={name} prominent/></li>)}</ul></dd></div>)}
    <div class="development-tools"><dt>개발 · AI 도구</dt><dd><ul>{developmentTools.map(name => <li><TechBadge name={name}/></li>)}</ul></dd></div>
  </dl>
  <a class="technology-cloud" href="/work/map/#cloud"><Icon name="cloud" size={18}/><span>Google Cloud · 운영·시험 환경 분리와 모니터링 구성 중</span><Icon name="arrow-up-right" size={16}/></a>
</div>
<style>
  .technology-overview{padding:22px 0 26px;border-block:1px solid var(--line);margin-bottom:34px}
  .technology-overview-title{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:20px}.technology-overview-title h3{font-size:17px;font-weight:700}.technology-overview-title>span{font-size:14px;color:var(--muted)}
  .technology-groups{display:grid;gap:12px;margin:0}.technology-groups>div{display:grid;grid-template-columns:145px minmax(0,1fr);gap:18px;align-items:center}.technology-groups dt{font-size:14px;font-weight:600;color:var(--muted)}.technology-groups dd{margin:0;min-width:0}.technology-groups ul{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:8px;margin:0}.technology-groups li{margin:0}
  .technology-groups .development-tools{padding-top:14px;margin-top:2px;border-top:1px solid var(--line)}
  .technology-cloud{display:inline-flex;align-items:center;gap:9px;min-height:44px;font-size:14px;color:var(--blue);font-weight:550;margin-top:14px}.technology-cloud:hover{text-decoration:underline;text-underline-offset:4px}.technology-cloud>span{min-width:0}
  @media(max-width:700px){.technology-groups>div{grid-template-columns:1fr;gap:10px}.technology-groups{gap:18px}.technology-overview-title{gap:8px}.technology-overview{padding-top:20px;margin-bottom:28px}}
</style>
