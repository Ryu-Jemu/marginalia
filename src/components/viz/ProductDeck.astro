---
import PhoneDeck from './PhoneDeck.astro';
import { t, type Lang } from '../../i18n/ui';

import dartooStart from '../../assets/projects/dartoo/screen-start.png';
import dartooHome from '../../assets/projects/dartoo/screen-home.png';
import dartooDisclosure from '../../assets/projects/dartoo/screen-disclosure.png';
import dartooCompany from '../../assets/projects/dartoo/screen-company.png';
import dartooChat from '../../assets/projects/dartoo/screen-chat.png';

import mapSignin from '../../assets/projects/map/screen-signin.png';
import mapHome from '../../assets/projects/map/screen-home.png';
import mapItinerary from '../../assets/projects/map/screen-itinerary.png';
import mapPlace from '../../assets/projects/map/screen-place.png';

/**
 * Which screens belong to which product, kept out of the content files so a
 * device frame stays a rendering decision rather than a data one.
 */
interface Props {
  slug: string;
  lang?: Lang;
}
const { slug, lang = 'en' } = Astro.props;

const SETS: Record<string, Array<{ src: ImageMetadata; alt: string; key: string }>> = {
  dartoo: [
    { src: dartooStart, alt: 'Dartoo — sign-in screen', key: 'screen.signin' },
    { src: dartooHome, alt: 'Dartoo — the day’s filings and watched companies', key: 'screen.today' },
    { src: dartooDisclosure, alt: 'Dartoo — a filing with its generated summary', key: 'screen.filing' },
    { src: dartooCompany, alt: 'Dartoo — a company page with its filing history', key: 'screen.company' },
    { src: dartooChat, alt: 'Dartoo — the assistant answering a question about a filing', key: 'screen.ask' },
  ],
  map: [
    { src: mapSignin, alt: 'MAP — sign in with Kakao or with an email address', key: 'screen.signin' },
    { src: mapHome, alt: 'MAP — home, with the trip countdown and the day’s weather', key: 'screen.home' },
    { src: mapItinerary, alt: 'MAP — a generated itinerary with the route drawn', key: 'screen.itinerary' },
    { src: mapPlace, alt: 'MAP — a place with its photo, rating and review summary', key: 'screen.place' },
  ],
};

const shots = (SETS[slug] ?? []).map((s) => ({ ...s, screen: t(lang, s.key) }));
---

{shots.length > 0 && <PhoneDeck shots={shots} lang={lang} />}
